SH.sfGet = function(url)
    local req = (syn and syn.request) or (http and http.request) or request or http_request
    if type(req) == "function" then
        local ok, res = pcall(function() return req({ Url = url, Method = "GET" }) end)
        if ok and res then
            local body = res.Body or res.body
            local code = res.StatusCode or res.Status or res.status_code
            if body and (not code or code == 200) then return body end
        end
    end
    local ok2, body2 = pcall(function() return game:HttpGet(url) end)
    if ok2 then return body2 end
    return nil
end

SH.fetchServers = function()
    local body = SH.sfGet(D.ServerFinderURL)
    if not body or body == "" or body == "null" then
        S.ServerFinderCache = {}
        return false, "Failed to fetch or empty response"
    end
    local ok, data = pcall(function() return HttpService:JSONDecode(body) end)
    if not ok or type(data) ~= "table" then
        return false, "Invalid JSON"
    end
    local list = {}
    for jobId, info in pairs(data) do
        if type(info) == "table" then
            info.jobId = info.jobId or jobId
            table.insert(list, info)
        end
    end
    table.sort(list, function(a, b)
        return (tonumber(a.playerCount) or 0) > (tonumber(b.playerCount) or 0)
    end)
    S.ServerFinderCache = list
    return true, list
end

SH.formatServer = function(info)
    local job = tostring(info.jobId or "?")
    local pc = tostring(info.playerCount or "?")
    local maxp = tostring(info.maxPlayers or info.MaxPlayers or "?")
    local weather = tostring(info.weather or info.worldStatus or "-")
    local uptime = tostring(info.uptime or info.uptimeSeconds or "-")
    local events = info.events
    local evStr = "-"
    if type(events) == "table" then
        local t = {}
        for k, v in pairs(events) do
            if type(k) == "string" and (v == true or v == 1) then
                table.insert(t, k)
            elseif type(v) == "string" then
                table.insert(t, v)
            end
        end
        if #t > 0 then evStr = table.concat(t, ", ") end
    elseif type(events) == "string" then
        evStr = events
    end
    local cosmic = info.cosmicCount or info.starfall or ""
    local line = string.format("[%s/%s] %s\n  Events: %s\n  Weather: %s | Uptime: %s",
        pc, maxp, job:sub(1, 12) .. (job:len() > 12 and "…" or ""), evStr, weather, tostring(uptime))
    if cosmic ~= "" and cosmic ~= 0 then
        line = line .. " | Cosmic/Star: " .. tostring(cosmic)
    end
    return line, job, evStr
end

SH.buildServerText = function(filter)
    filter = string.lower(tostring(filter or S.ServerFinderFilter or ""))
    if #S.ServerFinderCache == 0 then
        return "No data yet.\nPress Load Servers."
    end
    local lines, shown = {}, 0
    for _, info in ipairs(S.ServerFinderCache) do
        local line, job, evStr = SH.formatServer(info)
        local hay = string.lower(line .. " " .. tostring(evStr) .. " " .. tostring(job))
        if filter == "" or hay:find(filter, 1, true) then
            table.insert(lines, line)
            table.insert(lines, "────────────")
            shown = shown + 1
            if shown >= 25 then break end
        end
    end
    if shown == 0 then
        return "No servers match the filter:\n" .. filter
    end
    return "Servers: " .. shown .. " (max 25)\n────────────\n" .. table.concat(lines, "\n")
end

SH.firstFilteredJobId = function(filter)
    filter = string.lower(tostring(filter or S.ServerFinderFilter or ""))
    for _, info in ipairs(S.ServerFinderCache) do
        local line, job, evStr = SH.formatServer(info)
        local hay = string.lower(line .. " " .. tostring(evStr) .. " " .. tostring(job))
        if filter == "" or hay:find(filter, 1, true) then
            return tostring(info.jobId or job)
        end
    end
    return nil
end

