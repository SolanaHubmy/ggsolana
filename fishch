SH.cleanEnchantText = function(s)
    return (s:gsub("[^%a%s%-]", ""):gsub("^%s+", ""):gsub("%s+$", ""):gsub("%s+", " "))
end

SH.getEquippedRodInfo = function()
    local info = { Name = "None", PrimaryEnchant = "None", SecondaryEnchant = "None" }
    pcall(function()
        local rodsContainer = PlayerGui.hud.safezone.equipment.rods.scroll.safezone
        for _, rodFrame in ipairs(rodsContainer:GetChildren()) do
            if rodFrame:IsA("Frame") then
                local equipBtn = rodFrame:FindFirstChild("equip")
                if equipBtn and equipBtn.Text == "[Equipped]" then
                    info.Name = rodFrame.Name
                    local enchantsFolder = rodFrame:FindFirstChild("rod") and rodFrame.rod:FindFirstChild("enchants")
                    if enchantsFolder then
                        local p = enchantsFolder:FindFirstChild("enchant")
                        if p and p.Text ~= "" then
                            local c = SH.cleanEnchantText(p.Text)
                            if c ~= "" then info.PrimaryEnchant = c end
                        end
                        local s = enchantsFolder:FindFirstChild("secondary")
                        if s and s.Text ~= "" then
                            local c = SH.cleanEnchantText(s.Text)
                            if c ~= "" then info.SecondaryEnchant = c end
                        end
                    end
                    break
                end
            end
        end
    end)
    return info
end

