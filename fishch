SH.isWaterPart = function(part)
    if not part:IsA("BasePart") then return false end
    local nameLower = string.lower(part.Name)
    for _, keyword in ipairs(D.WaterKeywords) do
        if string.find(nameLower, keyword) then return true end
    end
    if part.Transparency >= 0.3 and part.Transparency <= 0.9 then
        local c = part.Color
        if c.B > c.R and c.B > 0.3 then return true end
    end
    return false
end

SH.findWaterY = function(character, rod, castX, rootY, castZ, bobberSizeY)
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances = { character, rod }

    local result = Workspace:Raycast(Vector3.new(castX, rootY + 50, castZ), Vector3.new(0, -500, 0), rp)
    if result and result.Material == Enum.Material.Water then
        return result.Position.Y + bobberSizeY / 2
    end
    if result and result.Instance and SH.isWaterPart(result.Instance) then
        return result.Instance.Position.Y + result.Instance.Size.Y / 2
    end

    local op = OverlapParams.new()
    op.FilterDescendantsInstances = { character, rod }
    op.FilterType = Enum.RaycastFilterType.Exclude
    local nearby = Workspace:GetPartBoundsInBox(CFrame.new(castX, rootY, castZ), Vector3.new(20, 40, 20), op)
    for _, part in ipairs(nearby) do
        if SH.isWaterPart(part) then
            return part.Position.Y + part.Size.Y / 2
        end
    end

    local checkPos = Vector3.new(castX, rootY, castZ)
    local region = Region3.new(checkPos - Vector3.new(10, 50, 10), checkPos + Vector3.new(10, 50, 10))
    region = region:ExpandToGrid(4)
    local materials = Workspace.Terrain:ReadVoxels(region, 4)
    local size = materials.Size
    for x = 1, size.X do
        for y = size.Y, 1, -1 do
            for z = 1, size.Z do
                if materials[x][y][z] == Enum.Material.Water then
                    return region.CFrame.Position.Y + (y - size.Y / 2) * 4
                end
            end
        end
    end

    return rootY - 2
end

SH.startInstantBobber = function()
    RunService.RenderStepped:Connect(function()
        if not C.InstantBobber then
            S.BobberProcessed = {}
            return
        end
        local character = LocalPlayer.Character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local rod = character:FindFirstChildOfClass("Tool")
        local bobber = rod and rod:FindFirstChild("bobber")
        if not bobber or not bobber:IsA("BasePart") then return end

        bobber.CanCollide = false
        bobber.CanTouch = false
        bobber.CanQuery = false

        if not S.BobberProcessed[bobber] then
            local rootPos = hrp.Position
            local forward = hrp.CFrame.LookVector * 3
            local castX = rootPos.X + forward.X
            local castZ = rootPos.Z + forward.Z
            local targetY = SH.findWaterY(character, rod, castX, rootPos.Y, castZ, bobber.Size.Y)
            S.BobberProcessed[bobber] = Vector3.new(castX, targetY, castZ)
            bobber.Destroying:Once(function() S.BobberProcessed[bobber] = nil end)
        end

        local targetPos = S.BobberProcessed[bobber]
        if targetPos then
            bobber.CFrame = CFrame.new(targetPos.X, targetPos.Y, targetPos.Z)
            bobber.AssemblyLinearVelocity = Vector3.zero
            bobber.AssemblyAngularVelocity = Vector3.zero
        end
    end)
end

