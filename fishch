SH.toggleFly = function(state)
    C.Fly = state
    local hrp = SH.getHRP()
    local hum = SH.getHum()
    if not hrp or not hum then return end

    if state then
        S.FlyBV = Instance.new("BodyVelocity")
        S.FlyBV.MaxForce = Vector3.new(9e4, 9e4, 9e4)
        S.FlyBV.Velocity = Vector3.zero
        S.FlyBV.Parent = hrp

        S.FlyBG = Instance.new("BodyGyro")
        S.FlyBG.MaxTorque = Vector3.new(9e4, 9e4, 9e4)
        S.FlyBG.P = 1e4
        S.FlyBG.Parent = hrp

        S.FlyConn = RunService.RenderStepped:Connect(function()
            if not C.Fly or not hrp.Parent then return end
            local cam = Workspace.CurrentCamera
            local dir = Vector3.zero
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + cam.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - cam.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - cam.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + cam.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.yAxis end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir = dir - Vector3.yAxis end
            if dir.Magnitude > 0 then dir = dir.Unit end
            S.FlyBV.Velocity = dir * C.FlySpeed
            S.FlyBG.CFrame = cam.CFrame
            hum.PlatformStand = true
        end)
    else
        if S.FlyConn then S.FlyConn:Disconnect(); S.FlyConn = nil end
        if S.FlyBV then S.FlyBV:Destroy(); S.FlyBV = nil end
        if S.FlyBG then S.FlyBG:Destroy(); S.FlyBG = nil end
        if hum then hum.PlatformStand = false end
    end
end

