SH.parseAppraise = function(text)
    local cleanText = text:gsub("<[^>]*>", "")
    local hasShiny = cleanText:find("Shiny") ~= nil
    local hasSparkling = cleanText:find("Sparkling") ~= nil
    local hasBig = cleanText:find("Big") ~= nil

    local mutation = "None"
    for _, mutName in ipairs(D.DetectionList) do
        if mutName ~= "None" and cleanText:find(mutName, 1, true) then
            mutation = mutName
            break
        end
    end
    return { hasShiny = hasShiny, hasSparkling = hasSparkling, hasBig = hasBig, mutation = mutation }
end

SH.appraiseMatch = function(result)
    if C.TargetMutation == "None" and C.ShinyType == "None" and C.TargetSize == "None" then
        return false
    end
    if C.TargetMutation ~= "None" and result.mutation == C.TargetMutation then return true end
    if C.TargetSize == "Big" and result.hasBig then return true end
    if C.ShinyType == "Shiny" and result.hasShiny and not result.hasSparkling then return true end
    if C.ShinyType == "Sparkling" and result.hasSparkling then return true end
    if C.ShinyType == "Shiny + Sparkling" and result.hasShiny and result.hasSparkling then return true end
    return false
end

SH.runAutoAppraise = function()
    local net = SH.getNet()
    local dialogRF = net and net:FindFirstChild("RF/DialogInteract")
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp or not dialogRF then
        SH.notify("Appraise", "Character or remote not ready", 3)
        C.AutoAppraise = false
        SH.setToggle("AutoApp", false)
        return
    end

    task.spawn(function()
        local originalCFrame = hrp.CFrame
        hrp.CFrame = CFrame.new(448.84, 150.54, 207.15) * CFrame.Angles(0, math.rad(-86.58), 0)
        task.wait(0.5)

        local npc = Workspace:FindFirstChild("world") and Workspace.world:FindFirstChild("npcs")
            and Workspace.world.npcs:FindFirstChild("Appraiser")
        local prompt = npc and npc:FindFirstChildOfClass("ProximityPrompt")
        if prompt then
            pcall(fireproximityprompt, prompt)
            task.wait(1)
        else
            SH.notify("Appraise", "Appraiser prompt not found", 3)
            C.AutoAppraise = false
            SH.setToggle("AutoApp", false)
            hrp.CFrame = originalCFrame
            return
        end

        hrp.CFrame = originalCFrame
        task.wait(0.2)
        pcall(function() dialogRF:InvokeServer(1, 1) end)
        task.wait(0.3)

        while C.AutoAppraise do
            pcall(function() dialogRF:InvokeServer(6, 1) end)
            task.wait(0.01)
            pcall(function() dialogRF:InvokeServer(1, 1) end)
            task.wait(0.01)

            local subvalues = char:FindFirstChild("fishinfo")
                and char.fishinfo:FindFirstChild("Info")
                and char.fishinfo.Info:FindFirstChild("Subvalues")

            if subvalues and subvalues:IsA("TextLabel") then
