SH.setScreenSaver = function(enabled, mode)
    SH.destroyScreenSaver()
    if not enabled then return end
    local color = (mode == "White") and Color3.new(1, 1, 1) or Color3.new(0, 0, 0)
    local pg = LocalPlayer:FindFirstChild("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui", 5)
