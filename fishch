SH.toggleWalkOnWater = function(Value)
    if S.WowConn then S.WowConn:Disconnect(); S.WowConn = nil end
    if S.WaterPart then S.WaterPart:Destroy(); S.WaterPart = nil end
    if not Value then return end

    S.WaterPart = Instance.new("Part")
    S.WaterPart.Name = "SolanaHub_WalkOnWater"
    S.WaterPart.Size = Vector3.new(20, 1, 20)
    S.WaterPart.Transparency = 1
    S.WaterPart.Anchored = true
    S.WaterPart.CanCollide = true
    S.WaterPart.Parent = Workspace

    S.WowConn = RunService.Heartbeat:Connect(function()
        local root = SH.getHRP()
        local hum = SH.getHum()
        if not root or not hum or not S.WaterPart then return end
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Include
        params.FilterDescendantsInstances = { Workspace.Terrain }
        params.IgnoreWater = false
        local ray = Workspace:Raycast(root.Position + Vector3.new(0, 10, 0), Vector3.new(0, -500, 0), params)
        if ray and ray.Material == Enum.Material.Water then
            S.WaterPart.CFrame = CFrame.new(root.Position.X, ray.Position.Y - 0.5, root.Position.Z)
        else
            S.WaterPart.CFrame = CFrame.new(0, -1000, 0)
        end
    end)
end

SH.toggleAntiAFK = function(Value)
    if S.AntiAFKConn then S.AntiAFKConn:Disconnect(); S.AntiAFKConn = nil end
    if Value then
        S.AntiAFKConn = LocalPlayer.Idled:Connect(function()
            VirtualUser:CaptureController()
            VirtualUser:ClickButton2(Vector2.new())
        end)
    end
end

SH.toggleFreeze = function(Value)
    if S.FreezeConn then S.FreezeConn:Disconnect(); S.FreezeConn = nil end
    if Value then
        local hrp = SH.getHRP()
        if hrp then
            S.FrozenCFrame = hrp.CFrame
            S.FreezeConn = RunService.Heartbeat:Connect(function()
                local root = SH.getHRP()
                if root and S.FrozenCFrame then root.CFrame = S.FrozenCFrame end
            end)
        end
    else
        S.FrozenCFrame = nil
    end
end

SH.toggleFPS = function(Value)
    pcall(function()
        settings().Rendering.QualityLevel = Value and Enum.QualityLevel.Level01 or Enum.QualityLevel.Automatic
    end)
end

SH.destroyScreenSaver = function()
