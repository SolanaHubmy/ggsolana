SH.cancelFishing = function()
    local char = LocalPlayer.Character
    if not char then return end

    local rootPart = char:FindFirstChild("HumanoidRootPart")
    if rootPart then rootPart.Anchored = false end

    local reelUI = PlayerGui:FindFirstChild("reel")
    if reelUI then reelUI:Destroy() end

    local hud = PlayerGui:FindFirstChild("hud")
    if hud then hud.Enabled = true end

    local rod = SH.getEquippedRod()
    if rod then
        if rod.events:FindFirstChild("reset") then
            pcall(function() rod.events.reset:FireServer() end)
        end
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid then
            local rodName = rod.Name
            humanoid:UnequipTools()
            task.wait(0.1)
            local bp = SH.getBackpack()
            local backpackRod = bp and bp:FindFirstChild(rodName)
            if backpackRod then humanoid:EquipTool(backpackRod) end
        end
    end
end

SH.snapMatches = function(fish)
    local fishName = fish and fish.Name
    local fishMutation = fish and fish.Mutation
    local fishRarity = fish and (fish.Rarity or fish.rarity)
    local iShiny = fish and fish.Shiny == true
    local iSparkling = fish and fish.Sparkling == true

    local nameOk = (C.SnapFishName == "None") or (fishName == C.SnapFishName)
    local mutationOk = (C.SnapMutation == "None") or (fishMutation == C.SnapMutation)
    local rarityOk = (C.SnapRarity == "None") or (tostring(fishRarity) == C.SnapRarity)

    local shinyOk = false
    if C.SnapShinyType == "None" then
        shinyOk = true
    elseif C.SnapShinyType == "Shiny" then
        shinyOk = iShiny and not iSparkling
    elseif C.SnapShinyType == "Sparkling" then
        shinyOk = iSparkling
    elseif C.SnapShinyType == "Shiny + Sparkling" then
        shinyOk = iShiny and iSparkling
    end

    return (nameOk and mutationOk and shinyOk and rarityOk), fishName, fishMutation, fishRarity
end

SH.hookReel = function()
    local function findModule(name)
        for _, v in ipairs(ReplicatedStorage:GetDescendants()) do
            if v:IsA("ModuleScript") and v.Name == name then return v end
        end
        return nil
    end

    local reelModule = findModule("ReelController")
    if not reelModule then return end
    local ok, Controller = pcall(require, reelModule)
    if not ok or not Controller then return end

    if not Controller._OldStartReel then Controller._OldStartReel = Controller.StartReel end
    if not Controller._OldEndMinigame then Controller._OldEndMinigame = Controller.EndMinigame end

    Controller.EndMinigame = function(self, result)
        local root = SH.getHRP()
        if root then root.Anchored = false end
        return Controller._OldEndMinigame(self, result)
    end

    Controller.StartReel = function(data)
        if C.TotemActive then
            return Controller._OldStartReel(data)
        end

        if C.SnapReel then
            local matched, fishName, fishMutation, fishRarity = SH.snapMatches(data and data.fish)
            if not matched then
                task.spawn(SH.cancelFishing)
                return nil
            end

            SH.notify("Snap Reel", "Match: " .. tostring(fishName), 3)
            if C.WebhookEnabled then
                pcall(function()
                    SH.sendWebhook("🎣 Snap Reel Match",
                        "**Fish:** " .. tostring(fishName) ..
                        "\n**Mutation:** " .. tostring(fishMutation or "None") ..
                        "\n**Rarity:** " .. tostring(fishRarity or "?"), 5763719)
                end)
            end
        end

        local Minigame = Controller._OldStartReel(data)
        if not Minigame then return end

        task.spawn(function()
            while Minigame and Minigame.AddModifier do
                if C.Mode == "Fast" then
                    Minigame:AddModifier("barSize", "force", 1)
                    Minigame:AddModifier("progress", "force", 100)
                else
                    Minigame:AddModifier("barSize", "force", 1)
                    Minigame:AddModifier("resilience", "multiply", 5)
                end
                task.wait()
            end
        end)

        return Minigame
    end
end

