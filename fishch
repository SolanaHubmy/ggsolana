SH.runStorage = function()
    local hrp = SH.getHRP()
    local lastCFrame = hrp and hrp.CFrame
    if not lastCFrame then
        SH.notify("Storage", "Character not ready", 3)
        S.StorageActive = false
        return
    end

    local uids = SH.collectStorageUIDs()
    if #uids == 0 then
        SH.notify("Storage", "No fish match the filters", 3)
        S.StorageActive = false
        return
    end

    local net = SH.getNet()
    local aquariumJoin = net and net:FindFirstChild("RE/PersonalAquarium/Join")
    local addToStorage = net and net:FindFirstChild("RE/Storage/RequestAddToStorage")
    if not addToStorage then
        SH.notify("Storage", "Storage remote not found", 3)
        S.StorageActive = false
        return
    end

    if aquariumJoin then pcall(function() aquariumJoin:FireServer(10594128852) end) end
    task.wait(0.8)

    SH.teleportTo(D.StorageCFrame)
    local waited = 0
    while waited < 3 do
        local h = SH.getHRP()
        if h and (h.Position - D.StorageCFrame.Position).Magnitude <= D.StorageRadius then break end
        task.wait(0.1)
        waited = waited + 0.1
    end

    local count = 0
    for _, uid in ipairs(uids) do
        pcall(function() addToStorage:FireServer(uid) end)
        count = count + 1
        task.wait(0.1)
    end

    task.wait(0.5)
    SH.teleportTo(lastCFrame)
    SH.notify("Storage", "Sent " .. count .. " fish to storage", 3)
    S.StorageActive = false
end

SH.runStarCrater = function()
    if S.StarCraterActive then return end
    local hrp = SH.getHRP()
    local lastCFrame = hrp and hrp.CFrame

    local craters = {}
    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj.Name == "StarCrater" then table.insert(craters, obj) end
    end
    if #craters == 0 then
        SH.notify("Star Crater", "No Star Craters found", 3)
        return
    end

    S.StarCraterActive = true
    local totalClaim = 0

    for _, crater in ipairs(craters) do
        for _, item in ipairs(crater:GetChildren()) do
            local center = item:FindFirstChild("Center")
            if center then
                for _, child in ipairs(center:GetChildren()) do
                    if child:IsA("ProximityPrompt") and child.Parent then
                        local part = child.Parent
                        if part:IsA("BasePart") then
                            SH.teleportTo(CFrame.new(part.Position + Vector3.new(0, 3, 0)))
                            task.wait(0.5)
                        end
                        if pcall(fireproximityprompt, child) then
                            totalClaim = totalClaim + 1
                        end
                        task.wait(0.5)
                    end
                end
            end
        end
        task.wait(0.3)
    end

    if lastCFrame then SH.teleportTo(lastCFrame) end
    S.StarCraterActive = false
    SH.notify("Star Crater", "Claimed " .. totalClaim .. " prompts", 3)
end

