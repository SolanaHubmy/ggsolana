SH.runAutoTotem = function()
    task.spawn(function()
        local lastTimeOfDay = SH.getTimeOfDay()
        local lastUseTime = 0

        while C.AutoTotem do
            task.wait(1)
            local currentTime = SH.getTimeOfDay()
            local isTimeChanged = currentTime ~= lastTimeOfDay

            if isTimeChanged or (tick() - lastUseTime >= C.TotemDelay) then
                local totemToUse = currentTime == "Night" and C.TotemNight or C.TotemDay
                if totemToUse == "None" or totemToUse == "" then
                    SH.notify("Totem", "No " .. string.lower(currentTime) .. " totem selected", 3)
                elseif not C.TotemActive then
                    SH.useTotem(totemToUse)
                end
                lastUseTime = tick()
                lastTimeOfDay = currentTime
            end
        end
    end)
end

