SH.toggleRadar = function(state)
    if S.RadarLoop then
        task.cancel(S.RadarLoop)
        S.RadarLoop = nil
    end
    local function setRadar(on)
        local fishingPath = Workspace:FindFirstChild("zones") and Workspace.zones:FindFirstChild("fishing")
        if not fishingPath then return end
        for _, folder in ipairs(fishingPath:GetChildren()) do
            for _, name in ipairs({ "radar1", "radar2" }) do
                local obj = folder:FindFirstChild(name)
                if obj then
                    pcall(function()
                        if obj:IsA("BoolValue") then obj.Value = on end
                        obj.Enabled = on
                    end)
                end
            end
        end
    end
    if state then
        S.RadarLoop = task.spawn(function()
            while true do
                setRadar(true)
                task.wait(1)
            end
        end)
    else
        setRadar(false)
    end
end

