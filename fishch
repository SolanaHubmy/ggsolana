local function safeRun(label, fn)
    local ok, err = pcall(fn)
    if not ok then warn("[SolanaHub] " .. label .. " failed: " .. tostring(err)) end
end

local okUI, uiErr = xpcall(SH.buildUI, function(err)
    return debug.traceback(tostring(err))
end)
if not okUI then
    warn("[SolanaHub] UI build error: " .. tostring(uiErr))
end

safeRun("Connections", SH.startConnections)
safeRun("HookReel", SH.hookReel)
safeRun("AutoCast", SH.autoCastLoop)
