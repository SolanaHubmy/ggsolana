    if not bp then return out end

    local f = S.StorageFilter
    if f.Name == "None" and f.Rarity == "None" and f.Mutation == "None" then
        return out
    end

    local inv = SH.getInventory()
    for _, tool in ipairs(bp:GetChildren()) do
        local link = tool:FindFirstChild("link")
        if tool:IsA("Tool") and link and link:IsA("StringValue") and link.Value ~= "" and not seen[link.Value] then
            local uid = link.Value
            local item = inv[uid]
            local name = tool.Name
            local rarity = SH.getItemRarity(name)
            local mut = item and item.sub and item.sub.Mutation

            local okName = f.Name == "None" or name == f.Name
            local okRar = f.Rarity == "None" or rarity == f.Rarity
            local okMut = f.Mutation == "None" or mut == f.Mutation

            if okName and okRar and okMut then
                seen[uid] = true
                table.insert(out, uid)
            end
        end
    end
    return out
end

