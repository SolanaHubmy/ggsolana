        SH.notify("Server", "Enter a JobId first", 3)
        return
    end
    SH.notify("Server", "Joining JobId...", 2)
    pcall(function()
        TeleportService:TeleportToPlaceInstance(game.PlaceId, jobId, LocalPlayer)
