local function formatCash(amount)
    amount = tonumber(amount) or 0

    if amount >= 1000000000000 then
        return string.format("$%.2fT", amount / 1000000000000)
    elseif amount >= 1000000000 then
        return string.format("$%.2fB", amount / 1000000000)
    elseif amount >= 1000000 then
        return string.format("$%.2fM", amount / 1000000)
    elseif amount >= 1000 then
        return string.format("$%.1fK", amount / 1000)
    end

    return "$" .. tostring(math.floor(amount))
end

local function isEggHatchable(eggModel)
    if not eggModel or not eggModel:IsA("Model") then
        return false
    end

    if not eggModel:GetAttribute("EggKey") then
        return false
    end

    if eggModel:HasTag("Hatching") then
        return false
    end

    for _, descendant in ipairs(eggModel:GetDescendants()) do
        if descendant:IsA("TextLabel")
            and (descendant.Name == "Timer" or descendant.Text == "Ready"
                or string.find(descendant.Text, "Ready")) then
            if descendant.Text == "Ready" or string.find(descendant.Text, "Ready") then
                return true
            end
        end
    end

    for _, descendant in ipairs(eggModel:GetDescendants()) do
        if descendant:IsA("ProximityPrompt") and descendant.ActionText == "Hatch" and descendant.Enabled then
            return true
        end
    end

    local eggData = eggModel:FindFirstChild("EggData")
    local placeTime = eggData and eggData:FindFirstChild("PlaceTime") and eggData.PlaceTime.Value

    if placeTime and placeTime > 0 then
        local eggDefinition = eggsData and eggsData[eggModel.Name]
        local growthTime = eggDefinition and eggDefinition.GrowthTime

        if growthTime then
            local weight = eggData:FindFirstChild("Weight") and eggData.Weight.Value or 1

            if workspace:GetServerTimeNow() - placeTime >= growthTime * weight then
                return true
            end
        end
    end

    return false
end

local function hatchReadyEggs(force)
    if not force and not isAutoHatchEnabled then
        return 0
    end

    if not hatch then
        return 0
    end

    if eggRoute.running and (eggRoute.state == "APPROACH" or eggRoute.state == "PICKUP" or eggRoute.state == "RETURN") then
        return 0
    end

    local plot = findOwnPlot()
    local eggs = plot and plot:FindFirstChild("Eggs")

    if not eggs then
        return 0
    end

    local hatchedCount = 0

    for _, eggModel in ipairs(eggs:GetChildren()) do
        if not isHubAlive or not force and not isAutoHatchEnabled then
            break
        end

        if eggModel:IsA("Model") then
            local eggKey = eggModel:GetAttribute("EggKey")

            if eggKey and isEggHatchable(eggModel) then
                hatch:FireServer({ EggKey = eggKey })

                local deadline = os.clock() + 1.5

                while eggModel.Parent and eggModel:GetAttribute("EggKey") == eggKey
                    and os.clock() < deadline do
                    task.wait(0.05)
                end

                if not eggModel.Parent or eggModel:GetAttribute("EggKey") ~= eggKey then
                    hatchedCount = hatchedCount + 1
                end
            end
        end
    end

    return hatchedCount
end

local function mountFastestPet(force)
    if not mounting then
        return false
    end

    local character = localPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if not humanoid or humanoid.Health <= 0 then
        return false
    end

    if localPlayer:GetAttribute("IsRiding") == true then
        if humanoid.WalkSpeed >= 120 then
            return true
        elseif petDismount then
            pcall(function() petDismount:FireServer() end)
            task.wait(0.2)
        end
    end

    local bestTool = nil
    local backpack = localPlayer:FindFirstChild("Backpack")

    local function petSpeedScore(petName)
        if petName:find("Cerberus") then
            return 210
        end

        if petName:find("Phoenix") then
            return 180
        end

        if petName:find("TRex") then
            return 160
        end

        if petName:find("Cheetah") then
            return 130
        end

        if petName:find("Kangaroo") then
            return 110
        end

        return 50
    end

    local bestScore = -1

    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool")
                and (item:HasTag("Pet") or item:GetAttribute("PetName")
                    or item.Name:find("KG%]") or item.Name:find("Cerberus")
                    or item.Name:find("Phoenix") or item.Name:find("TRex")) then
                local score = petSpeedScore(item.Name)

                if score > bestScore then
                    bestScore = score
                    bestTool = item
                end
            end
        end
    end

    if character then
        for _, item in ipairs(character:GetChildren()) do
            if item:IsA("Tool")
                and (item:HasTag("Pet") or item:GetAttribute("PetName")
                    or item.Name:find("KG%]") or item.Name:find("Cerberus")
                    or item.Name:find("Phoenix") or item.Name:find("TRex")) then
                local score = petSpeedScore(item.Name)

                if score > bestScore then
                    bestScore = score
                    bestTool = item
                end
            end
        end
    end

    if not bestTool and force then
        local ranchPets = getRanchPets()

        if #ranchPets > 0 then
            local fastestPet = nil
            local fastestSpeed = -1

            for _, pet in ipairs(ranchPets) do
                local petDefinition = petsData and petsData[pet:GetAttribute("PetName") or pet.Name]
                local speed = petDefinition and petDefinition.Speed or 50

                if speed > fastestSpeed then
                    fastestSpeed = speed
                    fastestPet = pet
                end
            end

            if fastestPet and pickupPet then
                local petKey = fastestPet:GetAttribute("PetKey")

                if petKey then
                    pickupPet:FireServer(petKey)
                    task.wait(0.4)

                    if backpack then
                        for _, item in ipairs(backpack:GetChildren()) do
                            if item:IsA("Tool") and (item:HasTag("Pet") or item.Name:find("KG%]")) then
                                bestTool = item
                                break
                            end
                        end
                    end
                end
            end
        end
    end

    if bestTool and humanoid then
        if bestTool.Parent ~= character then
            humanoid:EquipTool(bestTool)
            task.wait(0.2)
        end

        mounting:FireServer()

        local deadline = os.clock()

        while os.clock() - deadline < 0.8 do
            if localPlayer:GetAttribute("IsRiding") == true then
                break
            end

            task.wait(0.05)
        end
    end

    return localPlayer:GetAttribute("IsRiding") == true
end

local function upgradeNextNest(force)
    if not force and not isAutoNestUpgradeEnabled then
        return false, "Disabled"
    end

    if not nests then
        return false, "Nests remote unavailable"
    end

    local unlockedBefore, _, pendingNests = getNestStatus()
    local nextNest = pendingNests[1]

    if not nextNest then
        return false, "All nests unlocked"
    end

    local nestPrice = tonumber(nextNest.Price) or tonumber(prices[nextNest.Index]) or math.huge

    if getCash() < nestPrice then
        return false, "Not enough cash"
    end

    nests:FireServer(nextNest.Index)

    local deadline = os.clock() + 2

    while os.clock() < deadline do
        task.wait(0.1)

        if getNestStatus() > unlockedBefore then
            return true, "Nest " .. tostring(nextNest.Index) .. " unlocked"
        end
    end

    return false, "Nest unlock was not confirmed"
