                                if mutation == "Magma" then
                                    magmaCount = magmaCount + 1
                                end

                                if mutation and tostring(mutation) ~= "" and mutation ~= "None" then
                                    mutatedCount = mutatedCount + 1
                                end
                            end
                        end
                    end

                    local volcanoText = string.format([[
<b>Carried Basket Egg:</b> %s
<b>Auto Dip:</b> %s
<b>Filter:</b> <font color='#55FFFF'>%s</font>
<b>Dips Attempted:</b> <font color='#FFFF55'>%d</font>
<b>Magma Successes:</b> <font color='#FF5500'>%d (900x Stats)</font>

<b>Backpack Mutation Vault:</b>
• <b>Magma Pets (+900x):</b> <font color='#FF5500'><b>%d pets</b></font>
• <b>Total Mutated Pets:</b> <font color='#55FF55'>%d pets</font>

<i>Note: Dipping eggs in the volcano top pool rolls a 15%% chance for Magma (+900x Stat Multiplier - highest in game).</i>]], basketEggText, volcanoConfig.AutoDipEnabled and "<font color='#00FF00'>ON</font>"
                        or "<font color='#FF4444'>OFF</font>", volcanoConfig.AutoDipRarityFilter, volcanoConfig.TotalDipsAttempted, volcanoConfig.TotalMagmaSuccess, magmaCount, mutatedCount)

                    hubState.Dashboards.Volcano:SetDescription(volcanoText)
                end)
            end

            if hubState.Dashboards.Weather then
                pcall(function()
                    local serverData = replicatedStorage:FindFirstChild("ServerData")

                    local weatherSnapshot = serverData
                        and serverData:GetAttribute("WeatherSnapshotV2")

                    local weatherLines = {}

                    if type(weatherSnapshot) == "string" and #weatherSnapshot > 0 then
                        local didDecode, decoded = pcall(httpService.JSONDecode, httpService, weatherSnapshot)

                        if didDecode and type(decoded) == "table" then
                            local weathers = decoded.Weathers or decoded
                            local now = workspace:GetServerTimeNow()

                            for _, weather in pairs(weathers) do
                                if type(weather) == "table" and type(weather.Type) == "string"
                                    and type(weather.EndsAt) == "number" and now < weather.EndsAt then
                                    local remaining = math.max(0, math.ceil(weather.EndsAt - now))

                                    table.insert(weatherLines, string.format(
                                        "• <b>%s Storm:</b> %dm %ds left", weather.Type, math.floor(remaining / 60),
                                        remaining % 60
                                    ))
                                end
                            end
                        end
                    end

                    local weatherBody = #weatherLines > 0 and table.concat(weatherLines, "\n")
                        or "<font color='#888888'>Clear skies (no active storms)</font>"

                    local weatherText = string.format([[
<b>Current Weather Events:</b>
%s

<b>Weather Mutation Odds (per lightning strike):</b>
• <b>Thunder:</b> Shocked (+100x Multiplier, 12%% chance)
• <b>Raging:</b> Rage (+300x Multiplier, 5%% chance)
• <b>Eternal:</b> Eternal (+900x Multiplier, 2%% chance)]], weatherBody)

                    hubState.Dashboards.Weather:SetDescription(weatherText)
                end)
            end

            if hubState.Dashboards.EggESP then
                pcall(function()
                    local rarityCounts = {
                        Common = 0,
                        Rare = 0,
                        Epic = 0,
                        Legendary = 0,
                        Mythic = 0,
                        Divine = 0,
                        Ethereal = 0,
                    }

                    local hasVolcanicEgg = false
                    local trackedEggCount = 0
                    local renderedEggs = workspace:FindFirstChild("RenderedEggs")

                    if renderedEggs then
                        for _, eggModel in ipairs(renderedEggs:GetChildren()) do
                            trackedEggCount = trackedEggCount + 1
                            local rarity = eggRarityByName[eggModel.Name] or "Common"
                            rarityCounts[rarity] = (rarityCounts[rarity] or 0) + 1

                            if eggModel.Name == "Volcanic Egg" then
                                hasVolcanicEgg = true
                            end
                        end
                    end

                    local espStatus = isEggEspEnabled and "<font color='#00FF00'>ON</font>"
                        or "<font color='#FF4444'>OFF</font>"

                    local volcanicStatus = hasVolcanicEgg
                            and "<font color='#00FF00'>Active in the volcano</font>"
                        or "<font color='#888888'>Not spawned</font>"

                    local filterText = "All Rarities"

                    if type(espRarityFilter) == "table" then
                        local selected = {}

                        for key, entry in pairs(espRarityFilter) do
                            if entry == true then
                                table.insert(selected, tostring(key))
                            end
                        end

                        if #selected == 0 or espRarityFilter["All Rarities"] then
                            filterText = "All Rarities"
                        else
                            filterText = table.concat(selected, ", ")
                        end
                    end

                    local espText = string.format([[
<b>ESP Status:</b> %s
<b>Active Tracked:</b> %d Eggs
<b>Selected Filter:</b> <font color='#55FFFF'>%s</font>

<b>Live Map Population:</b>
• Common: %d
Rare: %d
Epic: %d
• Legendary: %d
Mythic: %d
• <font color='#55FFFF'><b>Divine: %d</b></font>
<font color='#FF55FF'><b>Ethereal: %d</b></font>

<b>Volcanic Egg Radar:</b> %s]], espStatus, trackedEggCount, filterText, rarityCounts.Common, rarityCounts.Rare, rarityCounts.Epic, rarityCounts.Legendary, rarityCounts.Mythic, rarityCounts.Divine, rarityCounts.Ethereal, volcanicStatus)

                    hubState.Dashboards.EggESP:SetDescription(espText)
                end)
            end

            if hubState.Dashboards.EggRoute then
                pcall(function()
                    local stateColor = eggRoute.running and "#00FF00" or "#FFAA00"
                    local routeText = string.format(
                        "<b>State:</b> <font color='%s'>%s</font>\n<b>Message:</b> %s\n<b>Confirmed:</b> <font color='#FFFF55'>%d</font>\n<b>Last:</b> %s\n<b>Filter:</b> <font color='#55FFFF'>%s</font>\n<b>Error:</b> <font color='#FF8888'>%s</font>",
                        stateColor,
                        tostring(eggRoute.state),
                        tostring(eggRoute.message),
                        eggRoute.confirmed or 0,
                        tostring(eggRoute.lastEgg or "None"),
                        tostring(eggRoute.targetFilter or espFilterLabel),
                        tostring(eggRoute.lastError ~= "" and eggRoute.lastError or "-")
                    )
                    hubState.Dashboards.EggRoute:SetDescription(routeText)
                end)
            end

            if hubState.Dashboards.Protection then
                pcall(function()
                    local antiAfkStatus = isAntiAfkEnabled and "<font color='#00FF00'>ON</font>"
                        or "<font color='#FF4444'>OFF</font>"

                    local protectionText = string.format([[
<b>Anti-AFK Protection:</b> %s

<b>Summary:</b>
• <b>Idle Guard:</b> <font color='#00FF00'>Prevents the 20-minute idle disconnect</font>]], antiAfkStatus)

                    hubState.Dashboards.Protection:SetDescription(protectionText)
                end)
            end
        end
    end))

    trackWorker(task.spawn(function()
        while isHubAlive do
            task.wait(2.5)

            if isAutoBuyGearsEnabled then
                pcall(function() buyGears() end)
            end
        end
    end))

    trackWorker(task.spawn(function()
        while isHubAlive do
            task.wait(2.5)

            if isAutoBuyFoodsEnabled then
                pcall(function() buyFoods() end)
            end
        end
    end))

    trackWorker(task.spawn(function()
        while isHubAlive do
            task.wait(0.25)

            if isEggEspEnabled then
                pcall(updateEggEsp)
            end
        end
    end))

    trackWorker(task.spawn(function()
        while isHubAlive do
            task.wait(5)

            if isAutoClaimFusionEnabled then
                local fusionSlots = localPlayer:FindFirstChild("FusionSlots")
                local fusionStatus = fusionSlots and fusionSlots:GetAttribute("FusionStatus")

                if fusionStatus == "Waiting" then
                    local endsAt = tonumber(fusionSlots:GetAttribute("EndsAt")) or 0

                    if workspace:GetServerTimeNow() >= endsAt then
                        pcall(claimOrAdvanceFusion)
                    end
                elseif fusionStatus == "Result" then
                    pcall(claimOrAdvanceFusion)
                end
            end

            if isAutoFuseEnabled and not isEggRouteRunning() then
                pcall(function() runFusion() end)
            end
        end
    end))

    trackWorker(task.spawn(function()
        while isHubAlive do
            task.wait(4)

            if isAutoSellEnabled and not isEggRouteRunning() then
                pcall(function() sellTrashPets() end)
            end
        end
    end))

    trackWorker(task.spawn(function()
        while isHubAlive do
            task.wait(4)

            if lanternConfig.AutoPlace and not isEggRouteRunning() then
                pcall(function() placeBestLantern(false) end)
            end
        end
    end))

    trackWorker(task.spawn(function()
        local basket = localPlayer:FindFirstChild("Basket")

        if basket then
            basket.ChildAdded:Connect(function(child)
                if volcanoConfig.AutoDipEnabled and not isEggRouteRunning() and not volcanoConfig.IsDippingBusy then
                    task.defer(function()
                        if child and child.Parent == basket and isEggDipEligible(child) then
                            dipBasketEgg(false)
                        end
                    end)
                end
            end)
        end

        while isHubAlive do
            task.wait(0.6)

            if volcanoConfig.AutoDipEnabled and not isEggRouteRunning() and not volcanoConfig.IsDippingBusy then
                local currentBasket = localPlayer:FindFirstChild("Basket")

                if currentBasket and #currentBasket:GetChildren() > 0 then
                    for _, item in ipairs(currentBasket:GetChildren()) do
                        if isEggDipEligible(item) then
                            pcall(function() dipBasketEgg(false) end)
                            break
                        end
                    end
                end
            end
        end
    end))

    trackWorker(task.spawn(function()
        while isHubAlive do
            task.wait(2.5)
            local renderedEggs = workspace:FindFirstChild("RenderedEggs")

            if renderedEggs then
                for _, eggModel in ipairs(renderedEggs:GetChildren()) do
                    if eggModel.Name == "Volcanic Egg" then
                        if volcanoConfig.NotifyOnVolcanicSpawn and os.clock() - volcanoConfig.LastVolcanicEggAlert > 30 then
                            volcanoConfig.LastVolcanicEggAlert = os.clock()

                            pcall(function()
                                uiLibrary:Notify({
                                    Title = "Volcanic Egg Spawned",
                                    Content = "An Ethereal Volcanic Egg is active in the volcano (Volkaris secret pet).",
                                    Duration = 7,
                                })
                            end)
                        end

                        break
                    end
                end
            end
        end
    end))
end

local didInit, initError = pcall(function()
    local serverData = replicatedStorage:WaitForChild("ServerData", 10)
    activeEggsFolder = serverData and serverData:WaitForChild("ActiveEggs", 10)
    eggPickupRemote = gameRemotes and gameRemotes:FindFirstChild("EggPickup")
    eggArrivalClaimRemote = gameRemotes and gameRemotes:FindFirstChild("EggArrivalClaim")

    if eggPickupRemote then
        table.insert(eggRoute.connections, eggPickupRemote.OnClientEvent:Connect(handleEggPickupEvent))
    end

    local basket = localPlayer:FindFirstChild("Basket")

    if basket then
        table.insert(eggRoute.connections, basket.ChildRemoved:Connect(function(child)
            if currentPickup and child.Name == currentPickup.inventoryId then
                eggRoute.lastBasketRemoval = {
                    id = child.Name,
                    delivering = child:GetAttribute("Delivering") == true,
                    remainingSeconds = (tonumber(child:GetAttribute("BreakAt")) or 0)
                        - workspace:GetServerTimeNow(),
                }
            end
        end))
    end

    if localPlayer then
        table.insert(eggRoute.connections, localPlayer.CharacterRemoving:Connect(function()
            eggRoute.stop("Character changed")
        end))
    end

    -- Instant Egg Collect controls live in Farm > Instant (single UI)
    eggRoute.loaded = true
    setRouteState("IDLE", "Ready - enable the toggle or run a test")
end)

if not didInit then
    warn("[InitEggRoute Error] " .. tostring(initError))
end

uiLibrary:Notify({
    Type = "Success",
    Title = "Solana Hub Loaded",
    Content = "Ride A Pet | V 5.1 Unified",
    Duration = 4,
})
