local function autoRebirth()
    if not isAutoRebirthEnabled or not rebirth or not rebirthsData then
        return false, "Disabled or unavailable"
    end

    local savedData = localPlayer:FindFirstChild("SavedData")
    local rebirths = savedData and savedData:FindFirstChild("Rebirths")

    if not rebirths then
        return false, "Rebirth state unavailable"
    end

    local currentRebirths = rebirths.Value

    if rebirthsData.Cap and currentRebirths >= rebirthsData.Cap then
        return false, "Rebirth cap reached"
    end

    local didGetCost, rebirthCost = pcall(function()
        return rebirthsData.GetCost and rebirthsData.GetCost(currentRebirths)
            or rebirthsData.RiggedCost and rebirthsData.RiggedCost[currentRebirths + 1]
    end)

    if not didGetCost or type(rebirthCost) ~= "number" then
        return false, "Rebirth cost unavailable"
    end

    if getCash() < rebirthCost then
        return false, "Not enough cash"
    end

    rebirth:FireServer()

    local deadline = os.clock() + 3

    while rebirths.Value <= currentRebirths and os.clock() < deadline do
        task.wait(0.1)
    end

    if rebirths.Value > currentRebirths then
        return true, "Rebirth confirmed"
    end

    return false, "Rebirth was not confirmed"
end

