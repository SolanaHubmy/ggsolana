            while indexRewardStage.Value <= previousStage and os.clock() < deadline do
                task.wait(0.1)
            end

            if indexRewardStage.Value > previousStage then
                claimed = claimed + 1
            else
                table.insert(problems, "index unconfirmed")
            end
        else
