        return true
    end

    local eggRarity = eggRarityByName[eggName] or "Common"
    local rank = rarityRank[eggRarity] or 1

    for filterName, isEnabled in pairs(espFilters) do
        if isEnabled then
            if filterName == "All Wild Eggs (Any)" or filterName == "Common & Above (All)" then
                return true
            elseif filterName == "Rare & Above (Rare -> Ethereal)" and rank >= 2 then
                return true
            elseif filterName == "Epic & Above (Mushroom+ / Epic -> Ethereal)" and rank >= 3 then
                return true
            elseif filterName == "Legendary & Above (Glass+ / Legendary -> Ethereal)" and rank >= 4 then
                return true
            elseif filterName == "Mythic & Above (Diamond+ / Mythic -> Ethereal)" and rank >= 5 then
                return true
            elseif filterName == "Sinister Egg & Above" and rank >= 5 then
                return true
            elseif filterName == "Divine & Above (Aurora+ / Divine -> Ethereal)" and rank >= 6 then
                return true
            elseif (filterName == "Ethereal Only (Blackhole+ / Ethereal)" or filterName == "Ethereal Only")
                and rank >= 7 then
                return true
            elseif filterName == "Common Only" and eggRarity == "Common" then
                return true
            elseif filterName == "Rare Only" and eggRarity == "Rare" then
                return true
            elseif filterName == "Epic Only" and eggRarity == "Epic" then
                return true
            elseif filterName == "Legendary Only" and eggRarity == "Legendary" then
                return true
            elseif filterName == "Mythic Only" and eggRarity == "Mythic" then
                return true
            elseif filterName == "Divine Only" and eggRarity == "Divine" then
                return true
            elseif eggName == string.gsub(filterName, "%s+Only$", "") or eggName == filterName then
                return true
            end
        end
    end

    return false
end

