local function upgradeHatchLuck(force, forceMax)
    if not force and not isAutoHatchLuckEnabled then
        return false, "Disabled"
    end

    if not upgrades then
        return false, "Upgrades remote unavailable"
    end

    if localPlayer:GetAttribute("Setting_LuckMultiplier") == false then
        local updateSetting = gameRemotes and gameRemotes:FindFirstChild("UpdateSetting")

        if updateSetting then
            pcall(function() updateSetting:FireServer("LuckMultiplier", true) end)
            task.wait(0.2)
        end

        if localPlayer:GetAttribute("Setting_LuckMultiplier") == false then
            return false, "Enable Luck Multiplier in game settings first"
        end
    end

    local savedData = localPlayer:FindFirstChild("SavedData")
    local hatchUpgrades = savedData and savedData:FindFirstChild("HatchUpgrades")

    if not hatchUpgrades then
        return false, "HatchUpgrades state unavailable"
    end

    local freeHatchUpgrades = savedData:FindFirstChild("FreeHatchUpgrades")
    local freeUpgradeCount = freeHatchUpgrades and freeHatchUpgrades.Value or 0
    local currentLevel = hatchUpgrades.Value
    local cash = getCash()

    local upgradePrice = hatchLuckData and hatchLuckData.GetPrice and hatchLuckData.GetPrice(currentLevel)
        or hatchLuckData and hatchLuckData.BasePrice or 5

    local shouldBuyMax = forceMax == true
        or forceMax == nil and hatchLuckUpgradeMode == "Max (All Affordable)"

    if freeUpgradeCount > 0 then
        local useMaxFree = shouldBuyMax and "MaxFree" or nil

        if useMaxFree then
            upgrades:FireServer(useMaxFree)
        else
            upgrades:FireServer()
        end

        local deadline = os.clock() + 2

        while hatchUpgrades.Value <= currentLevel and os.clock() < deadline do
            task.wait(0.05)
        end

        local gained = hatchUpgrades.Value - currentLevel

        if gained > 0 then
            return true, string.format("Claimed %d Free Hatch Luck upgrade(s)", gained)
        end

        return false, "Free Hatch Luck upgrade unconfirmed"
    end

    if cash < upgradePrice then
        local shortfall = upgradePrice - cash

        return false, string.format(
            "Not enough cash (Need %s, Have %s, Short %s)", formatCash(upgradePrice), formatCash(cash), formatCash(shortfall)
        )
    end

    if shouldBuyMax then
        local affordableLevels, affordableCost = 0, 0

        if hatchLuckData and type(hatchLuckData.GetMaxAffordable) == "function" then
            affordableLevels, affordableCost = hatchLuckData.GetMaxAffordable(currentLevel, cash)
        else
            affordableLevels, affordableCost = 1, upgradePrice
        end

        if affordableLevels <= 0 or cash < affordableCost then
            return false, "Not enough cash for Max Hatch Luck"
        end

        upgrades:FireServer("Max")

        local deadline = os.clock() + 2.5

        while hatchUpgrades.Value <= currentLevel and os.clock() < deadline do
            task.wait(0.05)
        end

        local gained = hatchUpgrades.Value - currentLevel

        if gained > 0 then
            return true, string.format("Upgraded +%d Hatch Luck levels (Cost: %s)", gained, formatCash(affordableCost))
        end

        return false, "Max Hatch Luck upgrade unconfirmed"
    else
        upgrades:FireServer()

        local deadline = os.clock() + 2

        while hatchUpgrades.Value <= currentLevel and os.clock() < deadline do
            task.wait(0.05)
        end

        if hatchUpgrades.Value > currentLevel then
            return true, string.format(
                "Upgraded Hatch Luck to Lv. %d (Cost: %s)", hatchUpgrades.Value, formatCash(upgradePrice)
            )
        end

        return false, "Hatch Luck upgrade unconfirmed"
    end
end

local function collectPetEarnings(force)
    if not force and not isAutoCollectPetCashEnabled then
        return 0, "Disabled"
    end

    if not petCollect or not petRenderer or type(petRenderer.GetAll) ~= "function" then
        return 0, "Pet earnings controller unavailable"
    end

    if isEggRouteRunning() then
        return 0, "Egg route is running"
    end

    local character = localPlayer.Character
    local humanoidRootPart = character and character:FindFirstChild("HumanoidRootPart")

    if not humanoidRootPart then
        return 0, "Character not ready"
    end

    local originCFrame = humanoidRootPart.CFrame
    local collectedCount = 0
    local now = workspace:GetServerTimeNow()

    for _, petInfo in pairs(petRenderer.GetAll()) do
        if not isHubAlive or not force and not isAutoCollectPetCashEnabled then
            break
        end

        if petInfo.OwnerUserId == localPlayer.UserId and petInfo.Model and petInfo.Model.Parent
            and petInfo.PetKey then
            local income = tonumber(petInfo.Income) or 0
            local collectTime = tonumber(petInfo.CollectTime) or now
            local accrued = math.floor(math.max(0, income * (now - collectTime)))

            if income > 0 and accrued >= math.max(income, 1) then
                local petPosition = petInfo.Model:GetPivot().Position + Vector3.new(0, 3, 0)

                humanoidRootPart.CFrame = CFrame.new(petPosition) * humanoidRootPart.CFrame.Rotation
                humanoidRootPart.AssemblyLinearVelocity = Vector3.zero

                task.wait(0.15)

                if (humanoidRootPart.Position - petPosition).Magnitude <= 12 then
                    local previousCollectTime = tonumber(petInfo.CollectTime) or 0
                    petCollect:FireServer(petInfo.PetKey)

                    local deadline = os.clock() + 1.5

                    while (tonumber(petInfo.CollectTime) or 0) <= previousCollectTime and os.clock() < deadline do
                        task.wait(0.05)
                    end

                    if (tonumber(petInfo.CollectTime) or 0) > previousCollectTime then
                        collectedCount = collectedCount + 1
                    end
                end
            end
        end
    end

    if humanoidRootPart.Parent then
        humanoidRootPart.CFrame = originCFrame
        humanoidRootPart.AssemblyLinearVelocity = Vector3.zero
    end

    return collectedCount, collectedCount > 0 and "Pet earnings confirmed" or "No eligible pet earnings"
end

local function placeBestPets(force)
    if not force and not isAutoPlaceBestPetsEnabled then
        return false, "Disabled"
    end

    if isEggRouteRunning() then
        return false, "Egg route is running"
    end

    local playerGui = localPlayer:FindFirstChild("PlayerGui")
    local main = playerGui and playerGui:FindFirstChild("Main")
    local petsTracker = main and main:FindFirstChild("PetsTracker")
    local placeBestButton = petsTracker and petsTracker:FindFirstChild("PlaceBest", true)

    if not placeBestButton or not placeBestButton:IsA("GuiButton") then
        return false, "Place Best button unavailable"
    end

    local beforeKeys = {}

    for _, pet in ipairs(getRanchPets()) do
        beforeKeys[pet:GetAttribute("PetKey") or pet.Name] = true
    end

    if type(firesignal) == "function" then
        firesignal(placeBestButton.Activated)
    elseif type(getconnections) == "function" then
        for _, connection in ipairs(getconnections(placeBestButton.Activated)) do
            pcall(function() connection:Fire() end)
        end
    end

    local deadline = os.clock() + 3

    while os.clock() < deadline do
        task.wait(0.1)

        local hasChanged = false
        local afterKeys = {}

        for _, pet in ipairs(getRanchPets()) do
            afterKeys[pet:GetAttribute("PetKey") or pet.Name] = true
        end

        for key in pairs(beforeKeys) do
            if not afterKeys[key] then
                hasChanged = true
                break
            end
        end

        if not hasChanged then
            for key in pairs(afterKeys) do
                if not beforeKeys[key] then
                    hasChanged = true
                    break
                end
            end
        end

        if hasChanged then
            return true, "Ranch pet placement changed"
        end
    end

    return false, "No placement change observed; pets may already be best"
end

