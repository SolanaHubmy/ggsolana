                probe.Parent = hiddenUi
                probe:Destroy()

                isWritable = true
            end)

            if isWritable then
                return hiddenUi
            end
        end
    end

    local didGet, protectedContainer = pcall(function() return coreGui end)

    if didGet and typeof(protectedContainer) == "Instance" then
        local isWritable = false

        pcall(function()
            local probe = Instance.new("Folder")
