            end)

            handle.Instance = didAdd and instance or nil

            function handle:Click()
                if type(cfg.Callback) == "function" then
                    task.spawn(pcall, cfg.Callback)
                end
            end

            return handle
        end

        function section:AddDropdown(cfg)
            header()

            local title = stripTags(cfg.Title)
            local isMulti = cfg.Multi == true
            local values = {}

            for _, option in ipairs(cfg.Options or cfg.Values or {}) do
                values[#values + 1] = tostring(option)
            end

            local default = cfg.Default

            if isMulti then
                default = toList(default)
            elseif type(default) == "table" then
                default = default[1]
            end

            local handle = { Value = default }
            local isSilent = false

            local didAdd, instance = pcall(function()
                return host:AddDropdown({
                    Name = title,
                    Values = values,
                    Default = default,
                    Multi = isMulti,
                    Search = #values > 8,
                    AllowNone = isMulti,
                    Tooltip = cfg.Description,
                    Flag = makeFlag("D", sectionName, title),
                    Callback = function(value)
                        if not isMulti and type(value) == "table" then
                            value = value[1]
                        end

                        handle.Value = value

                        if isSilent then
                            return
                        end

                        if type(cfg.Callback) == "function" then
                            task.spawn(pcall, cfg.Callback, value)
                        end
                    end,
                })
            end)

            handle.Instance = didAdd and instance or nil
            attachTip(handle.Instance, title, cfg.Description)

            function handle:SetValue(value, silent)
                if type(self) ~= "table" or self ~= handle then
                    value = self
                end

                isSilent = silent == true
                handle.Value = value
                applyValue(handle.Instance, value)
                isSilent = false
            end

            handle.Set = handle.SetValue

            function handle:Get()
                return handle.Value
            end

            return handle
        end

        function section:AddSlider(cfg)
            header()

            local title = stripTags(cfg.Title)
            local increment = tonumber(cfg.Increment) or 1
            local rounding = 0

            if increment < 1 then
                rounding = increment <= 0.01 and 2 or 1
            end

            local unit = ""

            if cfg.Unit == "%" then
                unit = "%"
            elseif cfg.Unit then
                unit = " " .. tostring(cfg.Unit)
            end

            local handle = { Value = cfg.Default or cfg.Min or 0 }

            local didAdd, instance = pcall(function()
                return host:AddSlider({
                    Name = title,
                    Min = cfg.Min or 0,
                    Max = cfg.Max or 100,
                    Default = handle.Value,
                    Increment = increment,
                    Rounding = rounding,
                    Type = unit,
                    Flag = makeFlag("S", sectionName, title),
                    Callback = function(value)
                        handle.Value = value

                        if type(cfg.Callback) == "function" then
                            task.spawn(pcall, cfg.Callback, value)
                        end
                    end,
                })
            end)

            handle.Instance = didAdd and instance or nil
            attachTip(handle.Instance, title, cfg.Description)

            function handle:Get()
                return handle.Value
            end

            return handle
        end

        function section:AddInput(cfg)
            header()

            local title = stripTags(cfg.Title)
