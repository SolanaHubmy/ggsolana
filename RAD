            local function enableFpsBoost()
                if fpsBoostState then
                    return
                end

                fpsBoostState = { Effects = {}, Emitters = {}, Shadows = lightingService.GlobalShadows }

                pcall(function() lightingService.GlobalShadows = false end)

                for _, effect in ipairs(lightingService:GetChildren()) do
                    if effect:IsA("PostEffect") or effect:IsA("Atmosphere") then
                        local wasEnabled = effect:IsA("PostEffect") and effect.Enabled or nil

                        fpsBoostState.Effects[effect] = wasEnabled

                        if effect:IsA("PostEffect") then
                            pcall(function() effect.Enabled = false end)
                        end
                    end
                end

                for _, descendant in ipairs(workspace:GetDescendants()) do
                    if descendant:IsA("ParticleEmitter") or descendant:IsA("Trail") or descendant:IsA("Beam")
                        or descendant:IsA("Smoke") or descendant:IsA("Fire") or descendant:IsA("Sparkles") then
                        local wasEnabled = descendant.Enabled

                        if wasEnabled then
                            fpsBoostState.Emitters[descendant] = true
                            pcall(function() descendant.Enabled = false end)
                        end
                    end
                end

                pcall(function()
                    settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
                end)
            end

            local function disableFpsBoost()
                local state = fpsBoostState

                if not state then
                    return
                end

                fpsBoostState = nil

                pcall(function() lightingService.GlobalShadows = state.Shadows end)

                for effect, wasEnabled in pairs(state.Effects) do
                    if effect and effect.Parent and wasEnabled ~= nil then
                        pcall(function() effect.Enabled = wasEnabled end)
                    end
                end

                for emitter in pairs(state.Emitters) do
                    if emitter and emitter.Parent then
                        pcall(function() emitter.Enabled = true end)
                    end
                end
            end

