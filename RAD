                local lanternData = lanternsData and lanternsData[itemName] or lanternConfig.Tiers[itemName]

                if hasLanternTag or lanternData ~= nil then
                    local tier = lanternData and lanternData.Tier
                        or lanternConfig.Tiers[itemName] and lanternConfig.Tiers[itemName].Tier or 1

                    local sizeBonus = lanternData and lanternData.SizeBonus
                        or lanternConfig.Tiers[itemName] and lanternConfig.Tiers[itemName].SizeBonus or 0.1

                    table.insert(lanterns, {
                        Tool = item,
                        Name = itemName,
                        Tier = tier,
                        SizeBonus = sizeBonus,
                    })
                end
            end
        end
    end

    collectLanterns(localPlayer:FindFirstChildOfClass("Backpack"))
    collectLanterns(localPlayer.Character)

    return lanterns
end

local function sortLanterns(lanterns, priority)
    local sorted = {}

    if priority == "Best Tier First (Eternal > Magic > Royal > Cool > Basic)" then
        for _, lantern in ipairs(lanterns) do
            table.insert(sorted, lantern)
        end

        table.sort(sorted, function(a, b) return a.Tier > b.Tier end)
    elseif priority == "Lowest Tier First (Basic > Cool > Royal > Magic > Eternal)" then
        for _, lantern in ipairs(lanterns) do
            table.insert(sorted, lantern)
        end

        table.sort(sorted, function(a, b) return a.Tier < b.Tier end)
    else
        local targetName = nil

        if string.find(priority, "Eternal") then
            targetName = "Eternal Lantern"
        elseif string.find(priority, "Magic") then
            targetName = "Magic Lantern"
        elseif string.find(priority, "Royal") then
            targetName = "Royal Lantern"
        elseif string.find(priority, "Cool") then
            targetName = "Cool Lantern"
        elseif string.find(priority, "Basic") then
            targetName = "Basic Lantern"
        end

        for _, lantern in ipairs(lanterns) do
            if targetName and lantern.Name == targetName then
                table.insert(sorted, lantern)
            end
        end
    end

    return sorted
end

local function computeLanternPlacement(strategy)
    local plot = findOwnPlot()

    if not plot then
        return nil, 0
    end

    local baseplate = plot:FindFirstChild("Baseplate")

    local baseHeight = baseplate and baseplate:IsA("BasePart")
        and (baseplate.Position.Y + baseplate.Size.Y / 2 + 0.1)
        or 40314

    local eggs = plot:FindFirstChild("Eggs")
    local eggModels = eggs and eggs:GetChildren() or {}

    if strategy == "Centroid of Active Eggs (Best Coverage)" and #eggModels > 0 then
        local totalX, totalZ = 0, 0

        for _, eggModel in ipairs(eggModels) do
            local position = eggModel:GetPivot().Position
            totalX = totalX + position.X
            totalZ = totalZ + position.Z
        end

        return Vector3.new(totalX / #eggModels, baseHeight, totalZ / #eggModels), #eggModels
    end

    local nestsFolder = plot:FindFirstChild("Nests")
    local nestModels = nestsFolder and nestsFolder:GetChildren() or {}

    if #nestModels > 0 then
        local totalX, totalZ = 0, 0

        for _, nestModel in ipairs(nestModels) do
            local position = nestModel:GetPivot().Position
            totalX = totalX + position.X
            totalZ = totalZ + position.Z
        end

        return Vector3.new(totalX / #nestModels, baseHeight, totalZ / #nestModels), #eggModels
    end

    if baseplate and baseplate:IsA("BasePart") then
        return Vector3.new(baseplate.Position.X, baseHeight, baseplate.Position.Z), #eggModels
    end

    return nil, #eggModels
end

local function placeBestLantern(force)
    if isLanternActionInProgress then
        return false, "Action already in progress"
    end

    if not force and not lanternConfig.AutoPlace then
        return false, "Auto Place Lanterns is disabled"
    end

    if not placeLantern then
        return false, "PlaceLantern remote unavailable"
    end

    if isEggRouteRunning() then
        return false, "Egg route is currently active"
    end

    local activeLantern = findOwnLantern()

    if activeLantern then
        return false, "Active lantern already deployed (" .. tostring(activeLantern.Name) .. ")"
    end

    if not findOwnPlot() then
        return false, "Ranch plot not found"
    end

    local incubatingEggs = getIncubatingEggCount()

    if lanternConfig.OnlyWhenEggs and incubatingEggs == 0 and not force then
        return false, "No eggs currently incubating (saving lanterns)"
    end

    local lanterns = listBackpackLanterns()

    if #lanterns == 0 then
        return false, "No lanterns found in backpack"
    end

    local candidates = sortLanterns(lanterns, lanternConfig.Priority)

    if #candidates == 0 then
        return false, "No lanterns matching selected priority filter"
    end

    local chosenLantern = candidates[1]
    local placementPosition, boostedEggCount = computeLanternPlacement(lanternConfig.Strategy)

    if not placementPosition then
        return false, "Unable to compute ranch placement position"
    end

    local character = localPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if not character or not humanoid then
        return false, "Character humanoid unavailable"
    end

    isLanternActionInProgress = true

    local didRun, didPlace = pcall(function()
        humanoid:EquipTool(chosenLantern.Tool)
        task.wait(0.15)
        placeLantern:FireServer(chosenLantern.Name, placementPosition)
        task.wait(0.1)
        humanoid:UnequipTools()

        local deadline = os.clock() + 2
        local confirmed = false

        while os.clock() < deadline do
            task.wait(0.1)

            if findOwnLantern() ~= nil then
                confirmed = true
                break
            end
        end

        return confirmed
    end)

    isLanternActionInProgress = false

    if didRun and didPlace then
        return true, string.format("%s successfully placed! Boosting %d egg(s).", chosenLantern.Name, boostedEggCount)
    elseif didRun and not didPlace then
        return true, string.format("%s placement dispatched to server.", chosenLantern.Name)
    else
        return false, "Error placing lantern: " .. tostring(didPlace)
    end
end

local function runFusion(force)
    if not force and not isAutoFuseEnabled then
        return false, "Disabled"
    end

    if not fusionPetPlace or not fusionAction then
        return false, "Fusion remotes unavailable"
    end

    if isEggRouteRunning() then
        return false, "Egg route is currently active"
    end

    local fusionSlots = localPlayer:FindFirstChild("FusionSlots")

    if not fusionSlots then
        return false, "FusionSlots unavailable"
    end

    local fusionStatus = fusionSlots:GetAttribute("FusionStatus")

    if fusionStatus == "Waiting" or fusionStatus == "Result" then
        local didAdvance, advanceMessage = claimOrAdvanceFusion()

        if didAdvance then
            task.wait(1)
        else
            return false, advanceMessage
        end
    end

    fusionStatus = fusionSlots:GetAttribute("FusionStatus")

    if fusionStatus ~= nil then
        return false, "Fusion machine is currently busy (" .. tostring(fusionStatus) .. ")"
    end

    local duplicates = findLowestDuplicates(fusionTargetRarity)

    if #duplicates < 4 then
        return false, string.format("Need 4 %s pets (Found %d in backpack)", fusionTargetRarity, #duplicates)
    end

    local character, humanoidRootPart = ensureCharacterReady()
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if not character or not humanoidRootPart or not humanoid then
        return false, "Character is not ready"
    end

    local baseplate = findOwnBaseplate()

    local rarityName = string.gsub(fusionTargetRarity, "^Lowest%s+", "")
    rarityName = string.gsub(rarityName, "%s*%(4x%)$", "")

    local fuseCost = fusionData and fusionData.RarityFuseCost and fusionData.RarityFuseCost[rarityName] or 300000000

    if getCash() < fuseCost then
        return false, string.format("Not enough cash for %s fusion (Need %s)", rarityName, formatCash(fuseCost))
    end

    local fusionMachinePosition = Vector3.new(387.95, 40320.21, 751.96)

    humanoidRootPart.CFrame = CFrame.new(fusionMachinePosition + Vector3.new(0, 3, 0)) * humanoidRootPart.CFrame.Rotation
    humanoidRootPart.AssemblyLinearVelocity = Vector3.zero

    task.wait(0.4)

    for slotIndex = 1, 4 do
        if not isHubAlive then
            break
        end

        local duplicate = duplicates[slotIndex]
        local tool = duplicate and duplicate.tool

        if tool and tool.Parent then
            if tool.Parent ~= character then
                humanoid:EquipTool(tool)

                local deadline = os.clock() + 1.2

                while tool.Parent ~= character and os.clock() < deadline do
                    task.wait(0.05)
                end
            end

            if tool.Parent == character then
                fusionPetPlace:FireServer(slotIndex)
                task.wait(0.35)
            end
        end
    end

    local deadline = os.clock() + 2.5

    while fusionSlots:GetAttribute("Ready") ~= true and os.clock() < deadline do
        task.wait(0.1)
    end

    local didStart = false

    if fusionSlots:GetAttribute("Ready") == true then
        fusionAction:FireServer("Start")

        local startDeadline = os.clock() + 3

        while fusionSlots:GetAttribute("FusionStatus") ~= "Waiting" and os.clock() < startDeadline do
            task.wait(0.1)
        end

        didStart = fusionSlots:GetAttribute("FusionStatus") == "Waiting"
    end

    if baseplate and baseplate.Parent and humanoidRootPart and humanoidRootPart.Parent then
        humanoidRootPart.CFrame = CFrame.new(baseplate.Position + Vector3.new(0, baseplate.Size.Y / 2 + 3.5, 0))
            * humanoidRootPart.CFrame.Rotation

        humanoidRootPart.AssemblyLinearVelocity = Vector3.zero
    end

    if didStart then
        return true, string.format("Successfully started %s fusion! Returned to ranch.", rarityName)
    end

    return false, "Fusion could not be started; verify pet placement and cash."
end

local function dipBasketEgg(force)
    if volcanoConfig.IsDippingBusy then
        return false, "Dip in progress"
    end

    if not force and not volcanoConfig.AutoDipEnabled then
        return false, "Auto dip is disabled"
    end

    local basket = localPlayer:FindFirstChild("Basket")

    if not basket or #basket:GetChildren() == 0 then
        return false, "No basket egg to dip"
    end

    local basketEgg = nil

    for _, item in ipairs(basket:GetChildren()) do
        if isEggDipEligible(item) then
            basketEgg = item
            break
        end
    end

    if not basketEgg then
        if force then
            basketEgg = basket:GetChildren()[1]
        else
            return false, "No eligible undipped basket egg found"
        end
    end

    local humanoidRootPart = getHumanoidRootPart()

    if not humanoidRootPart then
        return false, "Character humanoid unavailable"
    end

    local didDip = dipEggInVolcano(localPlayer.Character, basketEgg)

    if volcanoConfig.AutoReturnToRanch or force then
        local baseplate = findOwnBaseplate()

        if baseplate and humanoidRootPart then
            humanoidRootPart.CFrame = CFrame.new(baseplate.Position + Vector3.new(0, baseplate.Size.Y / 2 + 3.5, 0))
                * humanoidRootPart.CFrame.Rotation

            humanoidRootPart.AssemblyLinearVelocity = Vector3.zero
        end
    end

    if didDip then
        return true, "Volcano dip confirmed! Returned to ranch."
    end

    return false, "Volcano dip timed out or cancelled"
end

