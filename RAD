    if #eggRoute.events > 12 then
        table.remove(eggRoute.events, 1)
    end

    if not currentPickup then
        return
    end

    if status == "Refused" and (targetId == currentPickup.targetId or targetId == nil) then
        if not currentPickup.pickupAcknowledged then
            currentPickup.refused = tostring(reason or "Request refused")
        end
    elseif status == "BasketFull" then
        currentPickup.refused = "Basket full"
    elseif status == "PickedUp" and targetId == currentPickup.targetId then
        currentPickup.pickupAcknowledged = true
        currentPickup.refused = nil
    elseif status == "Deposited" then
        currentPickup.depositAcknowledged = true
    end
end

