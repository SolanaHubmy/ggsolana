    local bridge = { _window = nil }
    local flagCounts = {}

    local function stripTags(text)
        return (tostring(text or ""):gsub("<[^>]+>", ""))
    end

    local function makeFlag(prefix, scope, title)
        local base = prefix .. ":" .. scope .. "/" .. title
        flagCounts[base] = (flagCounts[base] or 0) + 1

        if flagCounts[base] > 1 then
            base = base .. "#" .. flagCounts[base]
        end

        return base
    end

    local function applyValue(instance, value)
        if type(instance) ~= "table" then
            return false
        end

        for _, method in ipairs({ "SetValue", "Set", "Select" }) do
            local fn = instance[method]

            if type(fn) == "function" then
                if pcall(fn, instance, value) then
                    return true
                end
            end
        end

        return false
    end

    local function toList(value)
        local list = {}

        if type(value) ~= "table" then
            if value ~= nil then
                list[1] = tostring(value)
            end

            return list
        end

        for key, entry in pairs(value) do
            if type(key) == "number" then
                list[#list + 1] = tostring(entry)
            elseif entry == true then
                list[#list + 1] = tostring(key)
            end
        end

        table.sort(list)

        return list
    end

    local function applyText(instance, title, text)
        if type(instance) ~= "table" then
            return
        end

        local didSet = false

        for _, method in ipairs({ "SetContent", "SetDescription", "SetText", "Set", "Update", "SetValue" }) do
            local fn = instance[method]

            if type(fn) == "function" then
                local ok

                if method == "Set" or method == "Update" then
                    ok = pcall(fn, instance, { Name = title, Title = title, Content = text, Description = text, Text = text })
                else
                    ok = pcall(fn, instance, text)
                end

                if ok then
                    didSet = true
                    break
                end
            end
        end

        if not didSet then
            pcall(function()
                if instance.Content and instance.Content.Text ~= nil then
                    instance.Content.Text = text
                elseif instance.Description and instance.Description.Text ~= nil then
                    instance.Description.Text = text
                elseif instance.TextLabel then
                    instance.TextLabel.Text = text
                end
            end)
        end
    end

    -- Dashboard memakai rich text (<b>, <font>), pastikan label-nya mendukung
    local function enableRichText(instance)
        pcall(function()
            local root = instance and (instance.Root or instance.Frame or instance.Instance)

            if typeof(root) == "Instance" then
                for _, descendant in ipairs(root:GetDescendants()) do
                    if descendant:IsA("TextLabel") then
                        descendant.RichText = true
                    end
                end
            end
        end)
    end

    -- Pembungkus section: API lama -> elemen ModernV2
    local function wrapHost(host, sectionName, withHeader)
        local section = {}
        local pendingHeader = withHeader and sectionName or nil

        local function header()
            if pendingHeader then
                local text = pendingHeader
                pendingHeader = nil
                pcall(function() host:AddDivider({ Text = text }) end)
            end
        end

        -- Hover tooltip pakai CreateToolTips bawaan ModernV2 (sama seperti tombol).
        -- Dipasang ke Root elemen; kalau Root tidak ada, dilewati tanpa error.
        local function attachTip(instance, title, desc)
            desc = desc and tostring(desc) or ""
            if desc == "" or type(instance) ~= "table" then
                return
            end

            local root = instance.Root
            if typeof(root) ~= "Instance" then
                return
            end

            pcall(function()
                local tip = modern:CreateToolTips(root, title, desc)
                instance.Tip = tip
            end)
        end

        function section:AddLabel(cfg)
            header()

            local text = stripTags(cfg.Title or cfg.Text or cfg.Name)
            local didAdd, instance = pcall(function() return host:AddDivider({ Text = text }) end)

            return { Instance = didAdd and instance or nil, Set = function() end }
        end

        function section:AddParagraph(cfg)
            header()

            local title = stripTags(cfg.Title)
            local content = tostring(cfg.Content or cfg.Description or "")
            local handle = { Text = content }

            local didAdd, instance = pcall(function()
                return host:AddParagraph({
                    Name = title,
                    Title = title,
                    Content = content,
                    Description = content,
                    Text = content,
                })
            end)

            handle.Instance = didAdd and instance or nil
            enableRichText(handle.Instance)

            function handle:SetDescription(text)
                text = tostring(text or "")

                if text == handle.Text then
                    return
                end

                handle.Text = text
                applyText(handle.Instance, title, text)
            end

            handle.SetContent = handle.SetDescription
            handle.SetText = handle.SetDescription

            function handle:SetTitle() end

            return handle
        end

        function section:AddToggle(cfg)
            header()

            local title = stripTags(cfg.Title)
            local default = cfg.Default == true
            local handle = { Value = default }
            local isReady = false

            local didAdd, instance = pcall(function()
                local options = {
                    Name = title,
                    Default = default,
                    Flag = makeFlag("T", sectionName, title),
                    Callback = function(value)
                        handle.Value = value == true

                        if not isReady and cfg.FireOnInit ~= true then
                            return
                        end

                        if type(cfg.Callback) == "function" then
                            task.spawn(pcall, cfg.Callback, handle.Value)
                        end
                    end,
                }

                if cfg.Description then
                    options.Tooltip = cfg.Description
                end

                return host:AddToggle(options)
            end)

            handle.Instance = didAdd and instance or nil
            attachTip(handle.Instance, title, cfg.Description)

            task.delay(0.4, function() isReady = true end)

            function handle:Set(value)
                handle.Value = value == true
                applyValue(handle.Instance, handle.Value)
            end

            handle.SetValue = handle.Set

            function handle:Get()
                return handle.Value
            end

            return handle
        end

        function section:AddButton(cfg)
            header()

            local title = stripTags(cfg.Title)
            local handle = {}

            local didAdd, instance = pcall(function()
                return host:AddButton({
                    Name = title,
                    ToolTip = cfg.Description,
                    Tooltip = cfg.Description,
                    Callback = function()
                        if type(cfg.Callback) == "function" then
