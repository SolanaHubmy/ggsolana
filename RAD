                continue
            end

            if position.X ~= position.X or position.Y ~= position.Y or position.Z ~= position.Z then
                continue
            end

            if not matchesEggFilter(eggName) then
                continue
            end

            local privateTo = eggPart:GetAttribute("PrivateTo")

            if privateTo and privateTo ~= localPlayer.UserId then
                continue
            end

            if eggPart:GetAttribute("AdminSpawn") == true then
                continue
            end

            if (tonumber(eggPart:GetAttribute("DropEndsAt")) or 0) > now then
                continue
            end

            local cycle = tonumber(eggPart:GetAttribute("Cycle"))
            local collectedCount = tonumber(collectedEggCycles[eggName])

            if cycle and collectedCount and collectedCount >= cycle then
                continue
            end

            local distance = (characterRoot.Position - position).Magnitude

            if distance < nearestDistance then
                nearestDistance = distance

                nearest = {
                    instance = eggPart,
                    id = eggPart.Name,
                    name = eggName,
                    position = position,
                    distance = distance,
                }
            end
        end

        return nearest
    end

    local function assertRunContext(generation, character)
        assert(eggRoute.alive and eggRoute.running and eggRoute.generation == generation, "Run cancelled")
        assert(localPlayer.Character == character, "Character changed; start a new run")

        local _, humanoidRootPart = ensureCharacterReady()
        return humanoidRootPart
    end

    local function waitForCondition(generation, character, timeout, predicate)
        local deadline = os.clock() + timeout

        while os.clock() < deadline do
            assertRunContext(generation, character)
            local result = predicate()

            if result then
                return result
            end

            task.wait(0.05)
        end

        return nil
    end

    local function moveCharacterTo(generation, character, position)
        local humanoidRootPart = assertRunContext(generation, character)
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")

        if humanoid then
            humanoid:Move(Vector3.zero, false)
        end

        humanoidRootPart.CFrame = CFrame.new(position) * humanoidRootPart.CFrame.Rotation
        humanoidRootPart.AssemblyLinearVelocity = Vector3.zero
        humanoidRootPart.AssemblyAngularVelocity = Vector3.zero

        task.wait(0.4)
        humanoidRootPart = assertRunContext(generation, character)
        local drift = (humanoidRootPart.Position - position).Magnitude

        if drift > 14 then
            if humanoid then
                humanoid:Move(Vector3.zero, false)
            end

            humanoidRootPart.CFrame = CFrame.new(position) * humanoidRootPart.CFrame.Rotation
            humanoidRootPart.AssemblyLinearVelocity = Vector3.zero
            humanoidRootPart.AssemblyAngularVelocity = Vector3.zero

            task.wait(0.2)
            humanoidRootPart = assertRunContext(generation, character)
            drift = (humanoidRootPart.Position - position).Magnitude
        end

        eggRoute.lastPositionError = drift

        assert(
            drift <= 14 + (userInputService.TouchEnabled and 14 or 0),
            string.format("Movement drift (%.1f studs); stopped", drift)
        )
    end

    local function runSingleEggCycle(generation)
        local character, humanoidRootPart = ensureCharacterReady()
        local basket = assert(localPlayer:FindFirstChild("Basket"), "Basket not loaded")

        if #basket:GetChildren() > 0 then
            setRouteState("DELIVER", "Delivering carried egg in basket to plot")
            task.wait(0.5)

            if #basket:GetChildren() > 0 then
                return false
            end
        end

        local baseplate = findOwnBaseplate()
        local target = findNearestEligibleEgg(humanoidRootPart)

        if not target then
            return false
        end

        local cycleStart = os.clock()

        eggRoute.targetId = target.id
        eggRoute.targetName = target.name
        eggRoute.targetDistance = target.distance

        setRouteState("APPROACH", target.name .. string.format(" | %.0f studs", target.distance))
        moveCharacterTo(generation, character, target.position + Vector3.new(0, 4, 0))
        assert(target.instance.Parent == activeEggsFolder, "Target expired before pickup")
        setRouteState("PICKUP", "Waiting for server basket confirmation")
        assertRunContext(generation, character)

        currentPickup = {
            targetId = target.id,
            targetName = target.name,
            requestedAt = workspace:GetServerTimeNow(),
        }

        eggRoute.pendingOperation = currentPickup

        if eggPickupRemote then
            eggPickupRemote:FireServer(target.id)
        end

        local pickedTool = waitForCondition(generation, character, 5, function()
            if currentPickup.refused then
                error("Pickup refused: " .. currentPickup.refused)
            end

            for _, item in ipairs(basket:GetChildren()) do
                if item:GetAttribute("Egg") == target.name then
                    return item
                end
            end

            return nil
        end)

        assert(pickedTool, "Pickup timed out; target skipped")

        local inventoryId = pickedTool.Name
        currentPickup.inventoryId = inventoryId
        eggRoute.pendingInventoryId = inventoryId

        local breakAt = tonumber(pickedTool:GetAttribute("BreakAt"))
        currentPickup.breakAt = breakAt

        assert(breakAt and breakAt > workspace:GetServerTimeNow(), "Egg timer expired before return")
        assert(baseplate.Parent, "Own plot baseplate missing")

        local carriedTool = basket:FindFirstChild(inventoryId)

        if volcanoConfig.AutoDipEnabled and carriedTool and isEggDipEligible(target.name, carriedTool) then
            setRouteState("VOLCANO", "Dipping " .. target.name .. " into Volcano Pool (15% Magma Roll)")

            if dipEggInVolcano(character, carriedTool) or carriedTool:GetAttribute("VolcanoDipped") == true then
                local refreshedBreakAt = tonumber(carriedTool:GetAttribute("BreakAt"))

                if refreshedBreakAt then
                    breakAt = refreshedBreakAt
                    currentPickup.breakAt = refreshedBreakAt
                end
            end
        end

        setRouteState("RETURN", "Returning " .. target.name .. " to your plot")
        moveCharacterTo(generation, character, baseplate.Position + Vector3.new(0, baseplate.Size.Y / 2 + 3.5, 0))

        if typeof(firetouchinterest) == "function" then
            pcall(function()
                firetouchinterest(humanoidRootPart, baseplate, 0)
                task.wait(0.05)
                firetouchinterest(humanoidRootPart, baseplate, 1)
            end)
        end

        setRouteState("VERIFY", "Matching basket claim on plot")

        local plotTool = basket:FindFirstChild(inventoryId)
        local currentRoot = assertRunContext(generation, character)
        local localPoint = baseplate.CFrame:PointToObjectSpace(currentRoot.Position)

        assert(math.abs(localPoint.X) <= baseplate.Size.X / 2 + 15
            and math.abs(localPoint.Z) <= baseplate.Size.Z / 2 + 15, "Arrival claim requires plot position")

        local arrivalTime = workspace:GetServerTimeNow()
        assert(arrivalTime <= breakAt + 0.5, "Egg expired before arrival claim")

        currentPickup.arrivalRequestedAt = arrivalTime
        eggRoute.lastArrivalRequestedAt = arrivalTime

        if plotTool and not plotTool:GetAttribute("Delivering") and not findToolByInventoryId(inventoryId)
            and eggArrivalClaimRemote then
            eggArrivalClaimRemote:FireServer(arrivalTime, currentRoot.Position, { inventoryId })
        end

        assert(waitForCondition(generation, character, 8, function()
            local depositedTool = findToolByInventoryId(inventoryId)

            if depositedTool and not basket:FindFirstChild(inventoryId) then
                return depositedTool
            end

            local plot = findOwnPlot()

            if plot and plot:FindFirstChild("Eggs") then
                for _, eggModel in ipairs(plot.Eggs:GetChildren()) do
                    if eggModel:GetAttribute("EggKey") == inventoryId then
                        return eggModel
                    end
                end
            end

            if not basket:FindFirstChild(inventoryId) then
                return true
            end

            local _, verifyRoot = ensureCharacterReady()
            local verifyPoint = baseplate.CFrame:PointToObjectSpace(verifyRoot.Position)

            assert(math.abs(verifyPoint.X) <= baseplate.Size.X / 2 + 15
                and math.abs(verifyPoint.Z) <= baseplate.Size.Z / 2 + 15, "Character moved away from plot; delivery halted")

            return nil
        end), "Delivery unconfirmed by server")

        eggRoute.confirmed = eggRoute.confirmed + 1
        eggRoute.lastEgg = target.name
        eggRoute.lastInventoryId = inventoryId
        eggRoute.lastCycleSeconds = os.clock() - cycleStart
        eggRoute.lastConfirmedTarget = target.id
        eggRoute.completedTargets[target.id] = true
        eggRoute.pendingInventoryId = nil
        eggRoute.pendingOperation = nil

        currentPickup = nil
        setRouteState("CONFIRMED", target.name .. string.format(" delivered in %.2fs", eggRoute.lastCycleSeconds))
        return true
    end

    local function recordRouteError(message)
        eggRoute.lastError = tostring(message)
        warn("[Fast Egg Steal] " .. eggRoute.lastError)
        return eggRoute.lastError
    end

    function eggRoute.start(runLimit)
        if not eggRoute.alive or eggRoute.running then
            return
        end

        eggRoute.running = true
        eggRoute.lastError = ""
        eggRoute.generation = eggRoute.generation + 1

        local generation = eggRoute.generation

        task.defer(function()
            local didRun, failure = xpcall(function()
                local confirmedThisRun = 0

                while eggRoute.running and eggRoute.alive and eggRoute.generation == generation do
                    local didCycle, cycleError = pcall(runSingleEggCycle, generation)

                    if not didCycle then
                        local errorText = tostring(cycleError)

                        if string.find(errorText, "cancelled") or not eggRoute.running or not eggRoute.alive
                            or eggRoute.generation ~= generation then
                            break
                        end

                        if currentPickup and currentPickup.targetId then
                            eggRoute.completedTargets[currentPickup.targetId] = true
                        end

                        if eggRoute.targetId then
                            eggRoute.completedTargets[eggRoute.targetId] = true
                        end

                        currentPickup = nil

                        eggRoute.pendingOperation = nil
                        eggRoute.lastError = errorText

                        if runLimit then
                            error(cycleError)
                        else
                            if string.find(errorText, "expired") or string.find(errorText, "refused")
                                or string.find(errorText, "gone") then
                                setRouteState("SEARCHING", "Target unavailable; finding next egg")
                                task.wait(0.5)
                            else
                                setRouteState("WAITING", "Waiting for matching egg to spawn (" .. tostring(espFilterLabel) .. ")")
                                task.wait(1.5)
                            end

                            continue
                        end
                    end

                    if not cycleError then
                        if runLimit then
                            setRouteState("DONE", "No eligible spawned eggs remain")
                            break
                        end

                        setRouteState("WAITING", "Waiting for matching egg to spawn (" .. tostring(espFilterLabel) .. ")")
                        task.wait(1.5)
                        continue
                    end

                    confirmedThisRun = confirmedThisRun + 1

                    if runLimit and confirmedThisRun >= runLimit then
                        setRouteState("DONE", tostring(confirmedThisRun) .. " egg(s) confirmed this run")
                        break
                    end

                    task.wait(0.6)
                end
            end, recordRouteError)

            if eggRoute.generation ~= generation or not eggRoute.alive then
                return
            end

            eggRoute.running = false

            if not didRun then
                setRouteState("STOPPED", tostring(failure))
            end
        end)
    end
end

local function makeDraggable(guiObject, dragHandle)
    dragHandle = dragHandle or guiObject

    local isDragging = false
    local hasMoved = false
    local dragStart, startPosition
    local releaseConnection

    dragHandle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            isDragging = true
            hasMoved = false
            dragStart = input.Position
            startPosition = guiObject.Position

            if releaseConnection then
                releaseConnection:Disconnect()
            end

            releaseConnection = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    isDragging = false

                    if releaseConnection then
                        releaseConnection:Disconnect()
                        releaseConnection = nil
                    end
                end
            end)
        end
    end)

    local latestInput

    dragHandle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            latestInput = input
        end
    end)

    userInputService.InputChanged:Connect(function(input)
        if input == latestInput and isDragging then
            local delta = input.Position - dragStart

            if delta.Magnitude > 8 then
                hasMoved = true
            end

            if hasMoved then
                guiObject.Position = UDim2.new(
                    startPosition.X.Scale, startPosition.X.Offset + delta.X, startPosition.Y.Scale,
                    startPosition.Y.Offset + delta.Y
                )
            end
        end
    end)
end

