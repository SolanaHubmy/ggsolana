local function isEggDipEligible(first, second)
    local eggInstance = typeof(second) == "Instance" and second
        or typeof(first) == "Instance" and first
        or nil

    local eggName = eggInstance and eggInstance:GetAttribute("Egg")
        or type(first) == "string" and first
        or eggInstance and eggInstance.Name
        or "Common Egg"

    if eggInstance then
        if eggInstance:GetAttribute("VolcanoDipped") == true then
            return false
        end

        if eggInstance:GetAttribute("Delivering") == true then
            return false
        end
    end

    local rarityFilter = volcanoConfig.AutoDipRarityFilter

    if rarityFilter == "All Eggs (Common to Ethereal)" then
        return true
    end

    local eggRarity = eggRarityByName and eggRarityByName[eggName]
        or eggsData and eggsData[eggName] and eggsData[eggName].Rarity
        or "Common"

    if rarityFilter == "Rare & Above" then
        return eggRarity ~= "Common"
    elseif rarityFilter == "Legendary & Above" then
        return eggRarity == "Legendary" or eggRarity == "Mythic" or eggRarity == "Divine"
            or eggRarity == "Ethereal"
    elseif rarityFilter == "Mythic & Above" then
        return eggRarity == "Mythic" or eggRarity == "Divine" or eggRarity == "Ethereal"
    elseif rarityFilter == "Ethereal / Volcanic Only" then
        return eggRarity == "Ethereal" or eggName == "Volcanic Egg"
    end

    return true
end

local function dipEggInVolcano(character, basketEgg)
    if not basketEgg or basketEgg:GetAttribute("VolcanoDipped") == true then
        return false
    end

    local humanoidRootPart = character and character:FindFirstChild("HumanoidRootPart")

    if not humanoidRootPart then
        return false
    end

    if not volcanoDip then
        return false
    end

    volcanoConfig.IsDippingBusy = true
    volcanoConfig.TotalDipsAttempted = volcanoConfig.TotalDipsAttempted + 1

    local standPlatform = Instance.new("Part")
    standPlatform.Name = "CM_VolcanoStandPlatform"
    standPlatform.Size = Vector3.new(40, 2, 40)
    standPlatform.CFrame = CFrame.new(-5102.84, 41408, -3489.11)
    standPlatform.Anchored = true
    standPlatform.CanCollide = true
    standPlatform.Transparency = 1
    standPlatform.Parent = workspace

    humanoidRootPart.CFrame = CFrame.new(-5102.84, 41411.5, -3489.11)
        * humanoidRootPart.CFrame.Rotation

    humanoidRootPart.AssemblyLinearVelocity = Vector3.zero
    humanoidRootPart.AssemblyAngularVelocity = Vector3.zero

    task.wait(0.25)

    local dipResult = nil
    local isCancelled = false

    local resultConnection = volcanoDipResult and volcanoDipResult.OnClientEvent:Connect(function(result)
        if result and result.Owner == localPlayer.UserId then
            dipResult = result
        end
    end)

    local cancelConnection = volcanoDipCancelled and volcanoDipCancelled.OnClientEvent:Connect(function(cancel)
        if cancel and cancel.Owner == localPlayer.UserId then
            isCancelled = true
        end
    end)

    volcanoDip:FireServer()

    local deadline = os.clock() + 3.5

    while not dipResult and not isCancelled and os.clock() < deadline do
        task.wait(0.05)
    end

    local arriveAt = dipResult and dipResult.ArriveAt or workspace:GetServerTimeNow() + 9.5
    local eggName = basketEgg and basketEgg:GetAttribute("Egg") or basketEgg and basketEgg.Name or "Egg"

    while not isCancelled and workspace:GetServerTimeNow() < arriveAt + 0.3 do
        local remaining = math.max(0, math.floor((arriveAt - workspace:GetServerTimeNow()) * 10) / 10)

        if eggRoute and eggRoute.running then
            setRouteState("VOLCANO", string.format("Mutating %s in Volcano... (%.1fs remaining)", eggName, remaining))
        end

        if not (basketEgg and basketEgg:GetAttribute("VolcanoUntil")) and remaining <= 0.5 then
            break
        end

        task.wait(0.2)
    end

    if resultConnection then
        resultConnection:Disconnect()
    end

    if cancelConnection then
        cancelConnection:Disconnect()
    end

    pcall(function() standPlatform:Destroy() end)

    volcanoConfig.IsDippingBusy = false

    local didDip = basketEgg:GetAttribute("VolcanoDipped") == true
        or (dipResult ~= nil and not isCancelled)

    if basketEgg:GetAttribute("Mutation") == "Magma"
        or dipResult and (dipResult.Success == true or dipResult.Mutation == "Magma") then
        volcanoConfig.TotalMagmaSuccess = volcanoConfig.TotalMagmaSuccess + 1

        pcall(function()
            uiLibrary:Notify({
                Title = "Magma Mutation",
                Content = string.format("%s rolled Magma (+900x stat multiplier).", tostring(eggName)),
                Duration = 5,
            })
        end)
    end

    return didDip and not isCancelled
end

