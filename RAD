local function findLowestDuplicates(targetLabel)
    local backpack = localPlayer:FindFirstChild("Backpack")
    local duplicates = {}

    if not backpack then
        return duplicates
    end

    local placedKeys = {}

    for _, pet in ipairs(getRanchPets()) do
        local petKey = pet:GetAttribute("PetKey")

        if petKey then
            placedKeys[petKey] = true
        end
    end

    local rarityName = string.gsub(targetLabel, "^Lowest%s+", "")
    rarityName = string.gsub(rarityName, "%s*%(4x%)$", "")

    for _, item in ipairs(backpack:GetChildren()) do
        if item:IsA("Tool") and item:HasTag("Pet") then
            local petName = item:GetAttribute("PetName")
            local petKey = item:GetAttribute("PetKey")

            if not (item:GetAttribute("Favorited") == true) and petKey and not placedKeys[petKey] then
                local petDefinition = petsData and petsData[petName]
                local rarity = petDefinition and petDefinition.Rarity or "Unknown"

                if rarity == rarityName then
                    local weight = tonumber(item:GetAttribute("Weight")) or 1

                    table.insert(duplicates, {
                        tool = item,
                        name = item.Name,
                        petName = petName,
                        petKey = petKey,
                        weight = weight,
                        rarity = rarity,
                    })
                end
            end
        end
    end

    table.sort(duplicates, function(a, b) return a.weight < b.weight end)
    return duplicates
end

local function claimOrAdvanceFusion()
    local fusionSlots = localPlayer:FindFirstChild("FusionSlots")
    local fusionResult = localPlayer:FindFirstChild("FusionResult")

    if not fusionSlots or not fusionAction then
        return false, "Fusion remotes unavailable"
    end

    local fusionStatus = fusionSlots:GetAttribute("FusionStatus")
    local now = workspace:GetServerTimeNow()

    if fusionStatus == "Waiting" then
        local endsAt = tonumber(fusionSlots:GetAttribute("EndsAt")) or 0

        if now >= endsAt then
            fusionAction:FireServer("Fuse")
            task.wait(1)
            fusionStatus = fusionSlots:GetAttribute("FusionStatus")
        else
            local remaining = math.ceil(endsAt - now)
            return false, string.format("Fusion in progress (%d seconds remaining)", remaining)
        end
    end

    if fusionStatus == "Result" then
        if fusionSlots:GetAttribute("FusionFailed") == true then
            fusionAction:FireServer("Claim", (fusionSlots:GetAttribute("FusionResultKey")))
            return true, "Claimed failed fusion compensation"
        end

        local pet = fusionResult and fusionResult:FindFirstChild("Pet")
        local petKey = pet and pet:GetAttribute("PetKey")

        if petKey then
            fusionAction:FireServer("Claim", petKey)

            local deadline = os.clock() + 2.5

            while fusionResult:FindFirstChild("Pet") and os.clock() < deadline do
                task.wait(0.1)
            end

            if not fusionResult:FindFirstChild("Pet") then
                return true, "Fused pet claimed to backpack!"
            end
        end

        return false, "Could not claim fused pet"
    end

    return false, "No fused pet ready to claim"
end

local function scanSellablePets()
    local sellable = {}

    local rarityCounts = {
        Common = 0,
        Rare = 0,
        Epic = 0,
        Legendary = 0,
        Mythic = 0,
        Divine = 0,
        Ethereal = 0,
        Secret = 0,
        Unknown = 0,
    }

    local placedKeys = {}
    local plot = findOwnPlot()
    local animals = plot and plot:FindFirstChild("Animals")

    if animals then
        for _, animal in ipairs(animals:GetChildren()) do
            local petKey = animal:GetAttribute("PetKey")

            if petKey then
                placedKeys[petKey] = true
            end
        end
    end

    local backpack = localPlayer and localPlayer:FindFirstChildOfClass("Backpack")
    local character = localPlayer and localPlayer.Character
    local tools = {}

    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool") then
                table.insert(tools, item)
            end
        end
    end

    if character then
        for _, item in ipairs(character:GetChildren()) do
            if item:IsA("Tool") then
                table.insert(tools, item)
            end
        end
    end

    local rankedPets = {}

    for _, tool in ipairs(tools) do
        local petName = tool:GetAttribute("PetName")
        local petKey = tool:GetAttribute("PetKey")

        if petKey and petName then
            local petDefinition = petsData and petsData[petName]
            local weight = tonumber(tool:GetAttribute("Weight")) or 0
            local baseIncome = petDefinition and petDefinition.BaseIncome or 0
            table.insert(rankedPets, { tool = tool, petKey = petKey, stat = baseIncome * 1000 + weight })
        end
    end

    local protectedKeys = {}

    if isProtectTopPetsEnabled and #rankedPets > 0 then
        table.sort(rankedPets, function(a, b) return a.stat > b.stat end)

        for index = 1, math.min(3, #rankedPets) do
            protectedKeys[rankedPets[index].petKey] = true
        end
    end

    for _, tool in ipairs(tools) do
        local petName = tool:GetAttribute("PetName")
        local petKey = tool:GetAttribute("PetKey")
        local isFavorited = tool:GetAttribute("Favorited") == true

        if petKey and petName then
            local petDefinition = petsData and petsData[petName]
            local rarity = petDefinition and petDefinition.Rarity or "Unknown"
            rarityCounts[rarity] = (rarityCounts[rarity] or 0) + 1

            if not isFavorited and not placedKeys[petKey] and not protectedKeys[petKey] then
                local mutation = tool:GetAttribute("Mutation")
                local spawnMutation = tool:GetAttribute("SpawnMutation")

                local hasMutation = isProtectMutatedPetsEnabled
                    and (mutation and tostring(mutation) ~= "" and mutation ~= "None"
                        or spawnMutation and tostring(spawnMutation) ~= "" and spawnMutation ~= "None")

                if sellRarityFilter[rarity] == true and not hasMutation then
                    table.insert(sellable, {
                        tool = tool,
                        name = tool.Name,
                        petName = petName,
                        petKey = petKey,
                        rarity = rarity,
                        weight = tonumber(tool:GetAttribute("Weight")) or 0,
                        mutation = mutation,
                    })
                end
            end
        end
    end

    return sellable, rarityCounts
end

local function sellTrashPets(force)
    if isSellInProgress then
        return false, "Sell action already in progress"
    end

    if not force and not isAutoSellEnabled then
        return false, "Auto Sell is disabled"
    end

    if not sellItems then
        return false, "SellItems remote unavailable"
    end

    if isEggRouteRunning() then
        return false, "Egg route is currently active"
    end

    local sellablePets = scanSellablePets()

    if #sellablePets == 0 then
        return false, "No eligible trash pets matching filters"
    end

    if not force then
        local backpack = localPlayer:FindFirstChildOfClass("Backpack")
        local backpackPetCount = 0

        if backpack then
            for _, item in ipairs(backpack:GetChildren()) do
                if item:IsA("Tool") and item:GetAttribute("PetKey") then
                    backpackPetCount = backpackPetCount + 1
                end
            end
        end

        if autoSellTrigger == "When Backpack >= 15 Pets" and backpackPetCount < 15 then
            return false, string.format("Backpack has %d/15 pets (waiting for threshold)", backpackPetCount)
        elseif autoSellTrigger == "When Backpack >= 20 Pets" and backpackPetCount < 20 then
            return false, string.format("Backpack has %d/20 pets (waiting for threshold)", backpackPetCount)
        end
    end

    isSellInProgress = true

    local didRun, success, message = pcall(function()
        local humanoidRootPart = getHumanoidRootPart()

        if not humanoidRootPart then
            return false, "No HumanoidRootPart"
        end

        local originPosition = humanoidRootPart.Position
        local richieStand = Vector3.new(174.36, 40320, 935)
        local richieLook = Vector3.new(174.36, 40319.09, 939.29)

        humanoidRootPart.CFrame = CFrame.lookAt(richieStand, richieLook)
        humanoidRootPart.AssemblyLinearVelocity = Vector3.zero

        task.wait(0.25)

        local petKeys = {}

        for _, pet in ipairs(sellablePets) do
            table.insert(petKeys, pet.petKey)
        end

        local sellPayload = { Pets = petKeys, Eggs = {} }
        local serverResponse = nil

        local responseConnection = sellItems.OnClientEvent:Connect(function(response)
            if type(response) == "table" then
                serverResponse = response
            end
        end)

        sellItems:FireServer(sellPayload)

        local deadline = os.clock() + 2.5

        while serverResponse == nil and os.clock() < deadline do
            task.wait(0.05)
        end

        if responseConnection then
            pcall(function() responseConnection:Disconnect() end)
        end

        local baseplate = findOwnBaseplate()

        if baseplate then
            humanoidRootPart.CFrame = CFrame.new(baseplate.Position + Vector3.new(0, baseplate.Size.Y / 2 + 3.5, 0))
                * humanoidRootPart.CFrame.Rotation
        elseif originPosition then
            humanoidRootPart.CFrame = CFrame.new(originPosition) * humanoidRootPart.CFrame.Rotation
        end

        humanoidRootPart.AssemblyLinearVelocity = Vector3.zero

        if serverResponse and serverResponse.Sold and serverResponse.Sold > 0 then
            return true, string.format("Sold %d trash pet(s) to Richie! Cash earned.", serverResponse.Sold)
        elseif serverResponse and serverResponse.Reason then
            return false, "Sell rejected: " .. tostring(serverResponse.Reason)
        else
            local backpack = localPlayer:FindFirstChildOfClass("Backpack")
            local remainingKeys = {}

            if backpack then
                for _, item in ipairs(backpack:GetChildren()) do
                    local petKey = item:GetAttribute("PetKey")

                    if petKey then
                        remainingKeys[petKey] = true
                    end
                end
            end

            local soldCount = 0

            for _, petKey in ipairs(petKeys) do
                if not remainingKeys[petKey] then
                    soldCount = soldCount + 1
                end
            end

            if soldCount > 0 then
                return true, string.format("Sold %d trash pet(s) (confirmed by inventory)!", soldCount)
            end

            return false, "Sell action timed out / unconfirmed"
        end
    end)

    isSellInProgress = false

    if didRun then
        return success, message
    end

    return false, "Error during sell action: " .. tostring(success)
end

